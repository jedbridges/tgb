---
import '~/styles/base.css';
import Seo from '~/components/Seo.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SearchPalette from '~/components/SearchPalette.astro';
import { GA4_ID } from '~/lib/analytics';
interface Props {
  title: string; description: string; image?: string;
  type?: 'website' | 'article' | 'book'; noindex?: boolean;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}
const { bodyClass, ...seo } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets the page fill the screen edge to edge on a notched phone,
         which is also what makes the env(safe-area-inset-*) values non-zero, so anything
         that needs to dodge the status bar or the home indicator can. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- What Safari paints its own chrome with: the strip behind the status bar, and the
         band under the page. It has to be the page's exact paper, and it has to follow the
         theme actually in force. Two things were wrong here. The dark value was #231f1d
         while the dark paper is #150f0c, so the strip was a visibly different colour from
         the page. And both were gated on prefers-color-scheme, which knows nothing about
         the site's own light/dark toggle, so anyone who pinned a scheme against their
         system got the other one's chrome. One tag, written below before the first paint,
         and corrected from the page's real background once there is a body to measure. -->
    <meta name="theme-color" content="#f2e8e4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#150f0c" media="(prefers-color-scheme: dark)" />
    <!-- Runs before the first byte of body is parsed, so a reader who pinned a scheme
         never sees the other one flash first. It writes one attribute and nothing else:
         the palette itself lives in tokens.css. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('tgb-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) { /* private mode: the system preference still applies */ }
      // Resolve the scheme the same way the toggle does, and hand Safari the matching
      // paper before it draws any of its own chrome.
      window.__tgbChrome = () => {
        const root = document.documentElement;
        const dark = (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
        const metas = document.querySelectorAll('meta[name="theme-color"]');
        if (!metas.length) return;
        // The two tags above are keyed to the system preference, which is right until the
        // reader pins a scheme against it. When they have, the media keys are dropped and
        // both tags carry the colour actually in force. Once there is a body, its computed
        // background IS the paper, so the chrome cannot drift from the palette.
        const pinned = !!root.dataset.theme;
        const measured = document.body && getComputedStyle(document.body).backgroundColor;
        const colour = measured && measured !== 'rgba(0, 0, 0, 0)' ? measured : (dark ? '#150f0c' : '#f2e8e4');
        metas.forEach((m) => { if (pinned) { m.removeAttribute('media'); m.setAttribute('content', colour); } });
      };
      window.__tgbChrome();
      addEventListener('DOMContentLoaded', () => window.__tgbChrome());
      // A page reached by taking a book off a shelf already has a motion: the cover
      // travels and the page rises behind it. Its masthead must not also set itself, or
      // two entrances play over each other. pagereveal fires before this document's first
      // frame, so the flag is in place before any of it can start.
      addEventListener('pagereveal', (e) => {
        if (e.viewTransition) document.documentElement.dataset.vtNav = '';
      });
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Safari reaches for a raster icon before an SVG one, and a browser that has already
         cached the old drawing is likelier to pick up a file it has never seen. -->
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- The faces the first screen actually needs: the headline's roman, the italic of the
         word that turns inside it, and the body roman. The 400 was left out when every page
         opened on a headline; now that an author page opens on a paragraph, its late arrival
         reflowed the whole bio (CLS 0.14). The rest load only if a page uses them. -->
    <link rel="preload" href="/fonts/gambetta-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gambetta-500i.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gambetta-400.woff2" as="font" type="font/woff2" crossorigin />
    <Seo {...seo} />
    {GA4_ID && (
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA4_ID, { anonymize_ip: true, send_page_view: true });
        const load = () => { const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID; document.head.appendChild(s); };
        'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 4000 }) : setTimeout(load, 1500);
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip ui" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchPalette />
    <script>
      import { track } from '~/lib/analytics';

      // The click. Which book, which retailer, which page it was clicked from.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-affiliate]');
        if (!a) return;
        track('affiliate_click', { retailer: a.dataset.affiliate, work: a.dataset.work, page: location.pathname });
      });

      // And the denominator. A click count on its own says which books are popular; it
      // cannot say which pages persuade, because a page seen ten times and clicked twice
      // and a page seen a thousand times and clicked twenty look identical. This reports
      // the view, so the number that matters, clicks per view, becomes computable per book.
      const view = document.querySelector<HTMLElement>('[data-work-view]');
      if (view) track('book_view', { work: view.dataset.workView, guide: view.dataset.workGuide, lists: view.dataset.workLists });

      // Which way in people actually use. Search, the filters and the shelf all cost
      // something to maintain and only one of them may be earning its place.
      document.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest<HTMLElement>('a.card[data-slug]');
        if (card) track('shelf_open', { work: card.dataset.slug, page: location.pathname });
      });
      addEventListener('tgb:search', (e) => track('search_used', { query_length: String((e as CustomEvent).detail?.length ?? 0) }));
      addEventListener('tgb:filter', (e) => track('filter_used', { facet: (e as CustomEvent).detail?.facet }));
    </script>
  </body>
</html>
<style is:global>
  .skip { position: absolute; left: var(--gutter); top: -3rem; background: var(--ink); color: var(--paper); padding: 0.5rem 0.8rem; border-radius: 3px; z-index: 100; text-decoration: none; }
  .skip:focus { top: var(--s1); }
  main:focus { outline: none; }
</style>
