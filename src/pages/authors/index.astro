---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { loadCatalog } from '~/lib/catalog';
import { authorUrl } from '~/lib/url';
import { breadcrumbs } from '~/lib/seo';
const { works, authors } = await loadCatalog();
const eras = (await getCollection('eras')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const byAuthor = new Map<string, number>();
for (const w of works) byAuthor.set(w.data.author.id, (byAuthor.get(w.data.author.id) ?? 0) + 1);
const groups = eras.map((e) => ({
  era: e,
  authors: [...authors.values()].filter((a) => a.data.era.id === e.id && byAuthor.has(a.id)).sort((a, b) => (a.data.born ?? 0) - (b.data.born ?? 0) || a.data.sortName.localeCompare(b.data.sortName)),
})).filter((g) => g.authors.length);
const dates = (a: (typeof groups)[number]['authors'][number]) => {
  const f = (y?: number) => (y === undefined ? '' : y < 0 ? `${-y} BCE` : `${y}`);
  if (a.data.floruit) return a.data.floruit;
  if (a.data.born === undefined) return '';
  return `${f(a.data.born)}–${f(a.data.died) || ''}`.replace(/–$/, '');
};
---
<Base title="Authors" description="Every author on the great college reading lists, arranged by era." jsonld={breadcrumbs([{ name: 'Authors', path: '/authors/' }])}>
  <section class="wrap head page-open">
    <h1 class="italic">Authors</h1>
    <p class="lede">{authors.size} writers across three thousand years, in the order they lived.</p>
  </section>
  {groups.map((g) => (
    <section class="wrap era">
      <h2 class="era__label"><span>{g.era.data.label}</span><span class="era__range ui">{g.era.data.start < 0 ? `${-g.era.data.start} BCE` : g.era.data.start} to {g.era.data.end < 0 ? `${-g.era.data.end} BCE` : g.era.data.end}</span></h2>
      <ul class="authors">
        {g.authors.map((a) => (
          <li>
            <a href={authorUrl(a.id)} class="author">
              <span class="author__name">{a.data.name}</span>
              <span class="author__dates ui">{dates(a)}</span>
              <span class="author__count ui">{byAuthor.get(a.id)} {byAuthor.get(a.id) === 1 ? 'work' : 'works'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
<style>
  .head { padding-block: var(--s4) var(--s3); }
  .head h1 { font-size: var(--step-4); }
  .lede { margin-top: var(--s1); font-size: var(--step-1); color: var(--ink-soft); }
  .era { padding-block: var(--s3); }
  .era__label { display: flex; align-items: baseline; gap: var(--s1); font-style: italic; font-size: var(--step-2); border-bottom: var(--rule-section); padding-bottom: var(--s0); }
  .era__range { color: var(--ink-mute); font-size: var(--step--2); letter-spacing: var(--tracking-caps); text-transform: uppercase; margin-left: auto; white-space: nowrap; }
    /* Name and dates each keep their own band across the row, so the rule under every
     author in a row falls on one line however long the name is. */
  .authors {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    grid-auto-rows: auto; column-gap: var(--s3); row-gap: 0;
  }
  .authors > li { grid-row: span 3; display: grid; grid-template-rows: subgrid; min-width: 0; }
  .author {
    grid-row: span 3; display: grid; grid-template-rows: subgrid;
    grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--s1);
    text-decoration: none; min-width: 0;
  }
  .author::after {
    content: ''; grid-row: 3; grid-column: 1 / -1;
    align-self: end; border-bottom: var(--rule); margin-top: 0.7rem;
  }
  .author__name { grid-row: 1; padding-top: 0.7rem; font-size: var(--step-1); color: var(--ink-strong); text-wrap: balance; }
  .author:hover .author__name { color: var(--accent-deep); }
  .author__dates { grid-row: 2; grid-column: 1; color: var(--ink-mute); font-size: var(--step--2); }
  .author__count { grid-column: 2; grid-row: 1; align-self: baseline; padding-top: 0.7rem; color: var(--ink-mute); font-size: var(--step--2); white-space: nowrap; }
</style>
