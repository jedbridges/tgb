---
import Base from '~/layouts/Base.astro';
import { url } from '~/lib/url';
---
<Base title="Not on the shelf" description="That page does not exist." noindex>
  <section class="wrap" style="padding-block: var(--s5); max-width: 44rem">
    <h1 style="font-style: italic">Not on this shelf.</h1>
    <p style="margin-top: var(--s2); font-size: var(--step-1)">The page you asked for isn't here. Try a search, or start from <a href={url('/books/')}>all books</a>.</p>
    <p style="margin-top: var(--s2)"><button class="btn" type="button" data-open-search>Search the library</button></p>
  </section>
</Base>
