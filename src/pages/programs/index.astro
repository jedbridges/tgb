---
import Base from '~/layouts/Base.astro';
import { loadCatalog } from '~/lib/catalog';
import { programUrl } from '~/lib/url';
import { breadcrumbs } from '~/lib/seo';
const { programs } = await loadCatalog();
const count = (p: (typeof programs)[number]) => new Set(p.data.segments.flatMap((s) => s.items.map((i) => i.work.id))).size;
const kindLabel = { college: 'Four-year college curriculum', course: 'Course sequence', series: 'Published series', list: 'Reading list' };
---
<Base title="The programs" description="The college Great Books curricula and canonical reading lists this site draws from, each in its own order." jsonld={breadcrumbs([{ name: 'Programs', path: '/programs/' }])}>
  <section class="wrap head page-open">
    <h1 class="italic">The programs</h1>
    <p class="lede">Nine reading lists, from four-year college curricula to the published canons that shaped them. Each page keeps the program's own order.</p>
  </section>
  <section class="wrap">
    <ol class="programs">
      {programs.map((p, i) => (
        <li class="program">
          <a href={programUrl(p.id)} class="program__link">
            <span class="program__body">
              <span class="program__name">{p.data.name}</span>
              <span class="program__kind ui">{kindLabel[p.data.kind]}{p.data.institution && p.data.institution !== p.data.name && ` · ${p.data.institution}`}</span>
              <span class="program__desc">{p.data.description.split(/\n\n/)[0]}</span>
            </span>
            <span class="program__count ui">
              <b>{count(p)}<span class="visually-hidden"> works</span></b>
              <span class="program__seg">{p.data.segments.length} {p.data.segmentLabel.toLowerCase()}{p.data.segments.length === 1 ? '' : 's'}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .head { padding-block: var(--s4) var(--s3); }
  .head h1 { font-size: var(--step-4); }
  .lede { margin-top: var(--s1); font-size: var(--step-1); color: var(--ink-soft); max-width: 50ch; }
  .programs { list-style: none; margin: 0; padding: 0; border-top: var(--rule-section); }
    /* Two bands: the name and its count share the first, the description has the second.
     The count used to be pushed down by a hand-measured 0.4rem to fake this. */
  .program__link {
    display: grid; grid-template-columns: minmax(0, 1fr) 7rem; grid-template-rows: auto auto;
    gap: var(--s-1) var(--s2); padding: var(--s2) 0; border-bottom: var(--rule);
    text-decoration: none; align-items: baseline; transition: background var(--dur-fast);
  }
  .program__link:hover { background: color-mix(in oklch, var(--paper-bright) 60%, transparent); }
  .program__body { grid-column: 1; grid-row: 1 / 3; display: grid; gap: var(--s-1); align-content: start; }
  .program__name { font-size: var(--step-2); font-style: italic; line-height: 1.1; color: var(--ink-strong); }
  .program__link:hover .program__name { color: var(--accent); }
  .program__kind { color: var(--ink-mute); font-size: var(--step--2); letter-spacing: 0.08em; text-transform: uppercase; }
  .program__desc { color: var(--ink-soft); max-width: 62ch; margin-top: var(--s-1); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    /* The column header already says these are works, so the numeral stands on its own.
     A screen reader still hears the unit, since out of the column it means nothing. */
  .program__count { grid-column: 2; grid-row: 1; display: grid; justify-items: end; gap: var(--s-1); text-align: right; color: var(--ink-soft); font-size: var(--step--2); line-height: 1.3; }
  .program__seg { white-space: nowrap; }
  .program__count b { font-family: var(--font-display); font-size: var(--step-2); color: var(--ink-strong); font-weight: var(--w-emph); }
  @media (max-width: 640px) { .program__link { grid-template-columns: 1fr; } .program__count { justify-items: start; text-align: left; } }
</style>
