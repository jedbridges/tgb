---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import BookCard from '~/components/BookCard.astro';
import { placeholderAuthor, loadCatalog, sortedByAssignment, programCount } from '~/lib/catalog';
import { programUrl, taxUrl, url } from '~/lib/url';
import { websiteLd } from '~/lib/seo';

const { works, authors, programs } = await loadCatalog();
const top = (await sortedByAssignment(works)).slice(0, 12);
const counts = await Promise.all(top.map((w) => programCount(w.id)));
const themeCounts = new Map<string, number>();
for (const w of works) for (const t of w.data.themes) themeCounts.set(t.id, (themeCounts.get(t.id) ?? 0) + 1);
const themes = (await getCollection('themes'))
  .map((t) => ({ ...t, n: themeCounts.get(t.id) ?? 0 }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 16);
const eras = (await getCollection('eras')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const eraCounts = new Map(eras.map((e) => [e.id, works.filter((w) => w.data.era.id === e.id).length]));
const eraMax = Math.max(1, ...eraCounts.values());
const progCount = (p: (typeof programs)[number]) => new Set(p.data.segments.flatMap((s) => s.items.map((i) => i.work.id))).size;

/**
 * The cycling word is not decoration: each one is true of what is actually on the shelf,
 * and the order alternates register so it never settles into a rhythm. Counts are the
 * works carrying that theme or form in the catalogue.
 */
const HEADLINE_WORDS = [
  'argument',   // knowledge, 251 works
  'poetry',     // lyric and epic
  'tragedy',    // 34 tragedies
  'doubt',      // the self
  'faith',      // 239
  'rebellion',  // liberty, 104
  'wonder',     // nature and the cosmos, 178
  'grief',      // mortality, 114
  'comedy',     // 29
  'justice',    // 148
  'desire',     // love, 149
  'exile',      // home and exile
];
---
<Base title="The Great Books" description={`The ${works.length} books that college Great Books programs ask students to read, with a guide to each one, its themes, and where to buy it.`} jsonld={websiteLd()} bodyClass="home">
  <section class="hero wrap">
    <div class="hero__text page-open">
      <h1 class="hero__h1">
        <span class="hero__lead">Three thousand years</span>
        <span class="hero__turn">
          <span class="hero__of">of</span>
          <span class="rotator" data-rotator aria-hidden="true">
            {HEADLINE_WORDS.map((w, i) => (
              <em class="rotator__word" data-active={i === 0 ? '' : undefined}>{w}</em>
            ))}
          </span>
        </span>
        <span class="visually-hidden">of {HEADLINE_WORDS[0]}, and everything else the great reading lists assign.</span>
      </h1>
      <p class="hero__lede">The ideas that built the West, argued out in the books themselves. {works.length} works, nine reading lists, a guide to each.</p>
      <div class="hero__actions set-hold">
        <a class="btn btn--accent" href={url('/books/')}>Browse the shelf</a>
        <button class="btn" type="button" data-open-search>Search inside every book</button>
      </div>
    </div>
  </section>

  <section class="wrap shelf-section">
    <header class="section-head">
      <h2 class="italic">Most assigned</h2>
      <a class="section-head__more ui" href={url('/books/')}>All {works.length} →</a>
    </header>
    <div class="shelf-grid shelf-open">
      {top.map((w, i) => <BookCard work={w} authorName={(authors.get(w.data.author.id) ?? placeholderAuthor(w.data.author.id)).data.name} width={140} programCount={counts[i]} index={i} eager={i < 6} />)}
    </div>
  </section>

  <section class="wrap programs-section">
    <header class="section-head">
      <h2 class="italic">Start from your program</h2>
      <a class="section-head__more ui" href={url('/programs/')}>All programs →</a>
    </header>
    <ul class="proglist">
      {programs.map((p) => (
        <li><a href={programUrl(p.id)} class="prog"><span class="prog__name">{p.data.shortName}</span><span class="prog__count ui">{progCount(p)} works</span></a></li>
      ))}
    </ul>
  </section>

  <section class="wrap eras-section">
    <header class="section-head">
      <h2 class="italic">Three thousand years</h2>
    </header>
    <ol class="timeline">
      {eras.map((e) => (
        <li><a href={taxUrl('eras', e.id)} class="tl">
          <span class="tl__bar" style={`--f:${((eraCounts.get(e.id) ?? 0) / eraMax).toFixed(3)}`}></span>
          <span class="tl__label">{e.data.label}</span>
          <span class="tl__count ui">{eraCounts.get(e.id)}</span>
        </a></li>
      ))}
    </ol>
  </section>

  <section class="wrap themes-section">
    <header class="section-head">
      <h2 class="italic">Or start from a question</h2>
    </header>
    <ul class="themecloud">
      {themes.map((t) => (
        <li>
          <a href={taxUrl('themes', t.id)}>
            <span class="themecloud__label">{t.data.label}</span>
            <span class="themecloud__n">{t.n}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
<script>
  // The headline names what is on the shelf. It is decoration only in the sense that the
  // page reads perfectly with the first word standing still, which is what happens when
  // scripting is off, when motion is reduced, and whenever the hero is not on screen.
  const rotator = document.querySelector<HTMLElement>('[data-rotator]');
  const words = rotator ? [...rotator.querySelectorAll<HTMLElement>('.rotator__word')] : [];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  if (rotator && words.length > 1) {
    let i = 0;
    let timer: number | undefined;
    let onScreen = true;

    const show = (next: number) => {
      words[i].removeAttribute('data-active');
      i = next % words.length;
      words[i].setAttribute('data-active', '');
    };
    const running = () => onScreen && !document.hidden && !reduce.matches;
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (!running()) return;
      timer = window.setInterval(() => show(i + 1), 2600);
    };

    document.addEventListener('visibilitychange', start);
    reduce.addEventListener('change', () => { if (reduce.matches) { show(0); stop(); } else start(); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; start(); }, { threshold: 0.1 }).observe(rotator);
    }
    start();
  }
</script>
<style>
  /* The hero is sized so the first shelf breaks the fold: the section heading and the top
     of the covers sit just inside the viewport, which shows the product and says there is
     more below without a scroll cue. min-height, not height, so short and landscape
     screens simply grow instead of clipping. svh keeps mobile browser chrome from lying. */
  .hero {
    padding-block: var(--s4) var(--s2);
    min-height: calc(100svh - var(--fold-peek, 17rem));
    display: grid;
    align-content: center;
  }
  @media (max-width: 700px) { .hero { --fold-peek: 15rem; } }
  @media (max-height: 640px) { .hero { min-height: 0; padding-block: var(--s4) var(--s3); } }
  .hero__text { max-width: 44rem; }
  /* Two lines at every width, breaking after "years" so that "of argument" reads as one
     phrase. The binding line is now the shorter of the two, which lets the type run larger.
     Sized against the viewport so it fits rather than wrapping wherever it likes. */
  .hero__h1 {
    display: grid; justify-items: start;
    font-size: clamp(1.7rem, 9vw, 6rem);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    text-wrap: nowrap;
  }
  .hero__lead { display: block; white-space: nowrap; }
  .hero__turn { display: flex; align-items: baseline; gap: 0.26em; white-space: nowrap; }
  .rotator { white-space: nowrap; }

  /* The words stack in one grid cell, so the slot is always as wide as the longest of them
     and the headline never reflows as they change. Nothing here animates layout. */
  .rotator { display: inline-grid; grid-template-areas: 'w'; }
  .rotator__word {
    grid-area: w;
    color: var(--accent);
    font-style: italic;
    opacity: 0;
    transform: translateY(0.34em);
    filter: blur(6px);
    transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out), filter 260ms var(--ease-out);
  }
  /* Entrances are slower than exits, so a word arrives with weight and leaves without fuss. */
  .rotator__word[data-active] {
    opacity: 1;
    transform: none;
    filter: none;
    transition: opacity 520ms var(--ease-out-expo), transform 600ms var(--ease-out-expo), filter 420ms var(--ease-out-expo);
  }
  @media (prefers-reduced-motion: reduce) {
    .rotator__word { transition: opacity 160ms linear; transform: none; filter: none; }
    .rotator__word[data-active] { transition: opacity 160ms linear; }
  }
  .hero__lede { margin-top: var(--s2); font-size: var(--step-0); line-height: var(--lh-prose); color: var(--ink-soft); max-width: 46ch; text-wrap: pretty; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s1); margin-top: var(--s3); }
  @media (max-width: 700px) {
    .hero__actions { display: grid; grid-template-columns: 1fr; gap: var(--s0); }
    .hero__actions .btn { width: 100%; min-height: 54px; }
  }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s2); border-top: var(--rule-section); padding-top: var(--s1); margin-bottom: var(--s3); }
  .section-head h2 { font-size: var(--step-3); }
  /* A tracked link sitting on a right edge leaves the tracking after its last character,
     which reads as the link being short of the margin. */
  .section-head__more { margin-right: -0.02em; }
  .section-head__more { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-soft); text-decoration: none; }
  .section-head__more:hover { color: var(--accent); }
  /* Every band below the hero opens the same way: a section rule, then its heading. The
     shelf used to open with no top padding at all, so its rule sat twice as close to the
     hero as the next three rules sat to each other. */
  .shelf-section, .programs-section, .eras-section, .themes-section { padding-block: var(--s4) 0; }
  .themes-section { padding-bottom: var(--s2); }
  /* Each row of this list shares one baseline for the names and one line for the rules.
     'Great Books (Britannica)' takes two lines and 'Yale DS' takes one, and before this
     the rule under each simply followed its own name down the page. */
  /* Wide enough that the longest name on the list, Great Books (Britannica), keeps one
     line. Rows take their height from their tallest name, so a single wrapped name opens a
     band of dead space under every short name beside it; the fix is to stop it wrapping
     rather than to let the rules drift apart. Nine programs land as three rows of three. */
  .proglist {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    grid-auto-rows: auto; column-gap: var(--s3); row-gap: 0;
  }
  .proglist > li { grid-row: span 2; display: grid; grid-template-rows: subgrid; min-width: 0; }
  .prog {
    grid-row: span 2; display: grid; grid-template-rows: subgrid;
    grid-template-columns: minmax(0, 1fr) auto; align-items: baseline;
    column-gap: var(--s1); text-decoration: none; min-width: 0;
  }
  .prog__name { grid-row: 1; font-size: var(--step-1); color: var(--ink-strong); padding-block: var(--s1) 0; text-wrap: balance; }
  .prog:hover .prog__name { color: var(--accent); }
  /* The rule is drawn by the row's last band so it lands at the same height in every
     column, and the count never breaks 'works' onto a line of its own. */
  .prog::after {
    content: ''; grid-row: 2; grid-column: 1 / -1;
    align-self: end; border-bottom: var(--rule); margin-top: var(--s1);
  }
  .prog__count {
    grid-row: 1; color: var(--ink-mute); font-size: var(--step--2);
    white-space: nowrap; padding-block: var(--s1) 0;
  }
  /* Three bands the whole strip shares: bar, label, count. Every column takes its row
     heights from the strip rather than from its own text, so a three-line era name no
     longer lifts its bar off the line the other twelve stand on. */
  .timeline {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto auto;
    column-gap: 4px; row-gap: var(--s0);
    align-items: end;
  }
  .timeline > li { grid-row: span 3; display: grid; grid-template-rows: subgrid; min-width: 0; }
  .tl {
    grid-row: span 3; display: grid; grid-template-rows: subgrid;
    text-decoration: none; min-width: 0; min-height: 44px;
  }
  /* Paper-on-paper made this chart invisible until hover. Give it real ink. */
  .tl__bar { display: block; height: calc(18px + var(--f) * 140px); background: color-mix(in oklch, var(--ink) 18%, var(--paper-deep)); border-top: 2px solid var(--ink); transition: background var(--dur-fast); }
  .tl:hover .tl__bar { background: var(--accent); }
  .tl__bar { align-self: end; }
  /* Thirteen eras across one page leaves each name a very narrow column, so the long ones
     are allowed to break inside a word rather than push their neighbours apart. */
  .tl__label { font-size: var(--step--2); line-height: 1.2; color: var(--ink-soft); hyphens: auto; text-wrap: pretty; }
  .tl__count { color: var(--ink-mute); font-size: var(--step--2); font-variant-numeric: tabular-nums; align-self: start; }
  .themecloud { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s0) var(--s2); }
  /* These were the only links on the page with no affordance. A pill would fight the type,
     since pills here belong to small sans-serif tags, so this uses the site's own link
     language instead: a rule set low enough to clear the italic descenders, plus the count
     of works, which both marks the link as a destination and says what is behind it. */
  .themecloud a {
    display: inline-flex; align-items: baseline; gap: 0.45em;
    min-height: 44px; padding-block: 0.1em;
    font-size: var(--step-2); font-style: italic; color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--edge-strong);
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .themecloud__n {
    font-family: var(--font-ui); font-style: normal; font-size: var(--step--2);
    align-self: baseline;
    font-variant-numeric: tabular-nums; color: var(--ink-mute);
    transition: color var(--dur-fast);
  }
  .themecloud a:hover, .themecloud a:focus-visible { color: var(--accent); border-bottom-color: var(--accent); }
  .themecloud a:hover .themecloud__n, .themecloud a:focus-visible .themecloud__n { color: var(--accent); }
  @media (max-width: 860px) {
    .timeline { grid-auto-flow: row; grid-template-columns: 1fr; grid-template-rows: none; gap: 0; align-items: stretch; }
    .timeline > li { grid-row: auto; display: block; }
    .tl {
      grid-row: auto; grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'label count' 'bar bar';
      align-items: baseline; gap: var(--s0) var(--s1); min-height: 48px;
      padding: var(--s0) 0 0.9rem; border-bottom: var(--rule);
    }
    .tl__label { grid-area: label; font-size: var(--step-0); color: var(--ink-strong); hyphens: manual; }
    .tl__count { grid-area: count; font-size: var(--step--1); align-self: baseline; }
    /* The bar becomes a rule under the row, filled in proportion. Unmistakably a measure. */
    .tl__bar {
      grid-area: bar; height: 3px; width: 100%; border: 0; background: var(--paper-deeper);
      background-image: linear-gradient(to right, var(--ink) 0, var(--ink) calc(var(--f) * 100%), transparent calc(var(--f) * 100%));
    }
    .tl:hover .tl__bar { background-image: linear-gradient(to right, var(--accent) 0, var(--accent) calc(var(--f) * 100%), transparent calc(var(--f) * 100%)); }
  }
</style>
