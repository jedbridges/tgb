---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import BookCard from '~/components/BookCard.astro';
import Browse from '~/components/browse/Browse';
import { placeholderAuthor, loadCatalog, catalogRecord, sortedByAssignment } from '~/lib/catalog';
import { breadcrumbs } from '~/lib/seo';

const { works, authors, programs } = await loadCatalog();
const sorted = await sortedByAssignment(works);
const rows = await Promise.all(sorted.map(catalogRecord));
const [themes, genres, eras, regions, languages] = await Promise.all([
  getCollection('themes'), getCollection('genres'), getCollection('eras'), getCollection('regions'), getCollection('languages'),
]);
const facets = {
  programs: programs.map((p) => ({ id: p.id, label: p.data.shortName, segments: [...p.data.segments].sort((a, b) => a.order - b.order).map((s) => ({ id: s.id, label: s.label })) })),
  themes: themes.map((t) => ({ id: t.id, label: t.data.label })).sort((a, b) => a.label.localeCompare(b.label)),
  genres: genres.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).map((t) => ({ id: t.id, label: t.data.label })),
  eras: eras.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).map((t) => ({ id: t.id, label: t.data.label })),
  regions: regions.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).map((t) => ({ id: t.id, label: t.data.label })),
  languages: languages.map((t) => ({ id: t.id, label: t.data.label })),
  authors: [...authors.values()].sort((a, b) => a.data.sortName.localeCompare(b.data.sortName)).map((a) => ({ id: a.id, label: a.data.name })),
};
---
<Base title="All the books" description={`Browse all ${works.length} works assigned across the great college reading lists. Filter by program, era, theme, form, difficulty and length, or search inside the summaries.`}
  jsonld={breadcrumbs([{ name: 'Books', path: '/books/' }])}>
  <section class="wrap browse-head">
    <p class="eyebrow">The shelf</p>
    <h1 class="italic">All the books</h1>
    <p class="browse-head__lede"><span id="browse-count">{works.length}</span> works from the great reading lists. Filter by what you're studying, or search inside every summary.</p>
  </section>
  <section class="wrap browse" data-pagefind-ignore>
    <Browse client:load rows={rows} facets={facets} total={works.length} />
    <div class="shelf-grid browse__grid" id="browse-grid" aria-live="polite">
      {sorted.map((w, i) => <BookCard work={w} authorName={(authors.get(w.data.author.id) ?? placeholderAuthor(w.data.author.id)).data.name} width={140} eager={i < 6} programCount={rows[i].pc} index={Math.min(i, 12)} />)}
    </div>
    <p class="browse__empty" id="browse-empty" hidden>Nothing on the shelf matches. Loosen a filter or try a different word.</p>
  </section>
</Base>
<style>
  .browse-head { padding-block: var(--s4) var(--s2); }
  .browse-head h1 { font-size: var(--step-4); }
  .browse-head__lede { margin-top: var(--s1); font-size: var(--step-1); color: var(--ink-soft); max-width: 50ch; }
  .browse { display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: var(--s3); align-items: start; padding-bottom: var(--s4); }
  .browse__grid { min-height: 20rem; }
  .browse__empty { grid-column: 2; padding: var(--s3); text-align: center; color: var(--ink-soft); font-style: italic; font-size: var(--step-1); }
  @media (max-width: 860px) { .browse { grid-template-columns: 1fr; } .browse__empty { grid-column: 1; } }
</style>
