---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import BookCard from '~/components/BookCard.astro';
import Browse from '~/components/browse/Browse';
import { placeholderAuthor, loadCatalog, catalogRecord, sortedByAssignment, hasGuide, guidedCount } from '~/lib/catalog';
import { breadcrumbs } from '~/lib/seo';

const { works, authors, programs } = await loadCatalog();
const sorted = await sortedByAssignment(works);
const rows = await Promise.all(sorted.map(catalogRecord));
const guideFlags = sorted.map(hasGuide);
const guided = await guidedCount();
const [themes, genres, eras, regions, languages] = await Promise.all([
  getCollection('themes'), getCollection('genres'), getCollection('eras'), getCollection('regions'), getCollection('languages'),
]);
const facets = {
  programs: programs.map((p) => ({ id: p.id, label: p.data.shortName, segments: [...p.data.segments].sort((a, b) => a.order - b.order).map((s) => ({ id: s.id, label: s.label })) })),
  themes: themes.map((t) => ({ id: t.id, label: t.data.label })).sort((a, b) => a.label.localeCompare(b.label)),
  genres: genres.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).map((t) => ({ id: t.id, label: t.data.label })),
  eras: eras.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).map((t) => ({ id: t.id, label: t.data.label })),
  regions: regions.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).map((t) => ({ id: t.id, label: t.data.label })),
  languages: languages.map((t) => ({ id: t.id, label: t.data.label })),
  authors: [...authors.values()].sort((a, b) => a.data.sortName.localeCompare(b.data.sortName)).map((a) => ({ id: a.id, label: a.data.name })),
};
---
<Base title="All the books" description={`Browse all ${works.length} works assigned across the great college reading lists. Filter by program, era, theme, form, difficulty and length, or search inside the summaries.`}
  jsonld={breadcrumbs([{ name: 'Books', path: '/books/' }])}>
  <section class="wrap browse-head">
    <h1 class="italic">All the books</h1>
    <p class="browse-head__lede">Every work on the nine lists, {guided} of them with a written reading guide so far. Filter by what you are studying, or search inside every summary.</p>
  </section>
  <section class="wrap browse" data-pagefind-ignore>
    <Browse client:load rows={rows} facets={facets} total={works.length} />
    <div class="browse__results">
      <a class="browse__skip" href="#browse-end">Skip the {works.length} results</a>
      <div class="shelf-grid browse__grid" id="browse-grid">
        {sorted.map((w, i) => <BookCard work={w} authorName={(authors.get(w.data.author.id) ?? placeholderAuthor(w.data.author.id)).data.name} width={140} eager={i < 6} programCount={rows[i].pc} hasGuide={guideFlags[i]} index={Math.min(i, 12)} />)}
      </div>
      <p class="browse__empty" id="browse-empty" hidden>No book on the shelf answers to all of that at once. Loosen a filter above, or try a different word.</p>
      <div id="browse-end" tabindex="-1"></div>
    </div>
  </section>
</Base>
<style>
  .browse-head { padding-block: var(--s4) var(--s2); }
  .browse-head h1 { font-size: var(--step-4); }
  .browse-head__lede { margin-top: var(--s1); font-size: var(--step-1); color: var(--ink-soft); max-width: 50ch; }
  .browse {
    display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: 0 var(--s3);
    grid-template-areas: 'search bar' 'rail results';
    align-items: start; padding-bottom: var(--s4);
  }
  .browse__results { grid-area: results; min-width: 0; }
  .browse__grid { min-height: 20rem; }
  .browse__empty { padding: var(--s4) var(--s2); max-width: 44ch; color: var(--ink-soft); font-size: var(--step-1); line-height: 1.5; }
  /* 689 links is a long walk for a keyboard. Offer the exit before the walk. */
  .browse__skip { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; font-family: var(--font-ui); font-size: var(--step--2); }
  .browse__skip:focus { position: static; width: auto; height: auto; clip-path: none; display: inline-block; margin-bottom: var(--s1); color: var(--accent-deep); }
  #browse-end:focus { outline: none; }
  /* On a phone: search first, then the count and sort, then filters, then the shelf. */
  @media (max-width: 860px) { .browse { grid-template-columns: 1fr; grid-template-areas: 'search' 'bar' 'rail' 'results'; } }
</style>
