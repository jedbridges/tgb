---
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Book3D from '~/components/Book3D.astro';
import BookCard from '~/components/BookCard.astro';
import BuyButtons from '~/components/BuyButtons.astro';
import FormPattern from '~/components/FormPattern.astro';
import { formFamily } from '~/lib/form';
import ProgramBadges from '~/components/ProgramBadges.astro';
import { placeholderAuthor, authorOf, coverFor, tintVars, relatedWorks, yearLabel, lengthLabel, lengthHint, difficultyLabel, programCount, hasGuide, guidedCount, loadCatalog } from '~/lib/catalog';
import { authorUrl, taxUrl, url, workUrl } from '~/lib/url';
import { bookLd, breadcrumbs } from '~/lib/seo';
import { amazonUrl } from '~/lib/affiliates';
import { toneFor } from '~/lib/tone';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}
const { work } = Astro.props;
const author = await authorOf(work);
const { Content } = await render(work);
const { image, meta: coverMeta } = coverFor(work.id);
// The borrowed colour, for the form texture behind the book; empty for greyscale covers.
const tint = tintVars(coverMeta);
const family = formFamily(work.data.genre.id);
const og = image ? (await getImage({ src: image, width: 800, format: 'jpg' })).src : undefined;
const related = await relatedWorks(work);
const { authors, assigned } = await loadCatalog();
const count = await programCount(work.id);
const guided = await guidedCount();
/*
 * A stub is a catalogue record: the synopsis, the edition and the buy links, on the same
 * template as 594 others. That is useful to a reader who lands on it and thin to a search
 * engine, and thin affiliate pages are named in Google's own spam policies, so 595 of them
 * would be judged against the 94 written guides rather than beside them. Stubs are therefore
 * noindex,follow (still crawled, still passing link equity) and dropped from the sitemap in
 * astro.config.mjs. Each one rejoins both by itself on the commit that gives it a guide.
 */
const hasGuideHere = work.data.status !== 'stub';
const hasNamedEdition = Boolean(work.data.recommendedEdition?.translator || work.data.recommendedEdition?.publisher);
const d = work.data;
const [era, genre, region, language] = await Promise.all([
  getEntry('eras', d.era.id), getEntry('genres', d.genre.id), getEntry('regions', d.region.id), getEntry('languages', d.language.id),
]);
const themeEntries = (await Promise.all(d.themes.map((t) => getEntry('themes', t.id)))).filter(Boolean);
const keyThemeEntries = await Promise.all(d.keyThemes.map(async (k) => ({ ...k, entry: await getEntry('themes', k.theme.id) })));
/*
 * Every book page is indexable.
 *
 * 641 of the 689 used to carry noindex because they have no written guide yet, which hid
 * 93% of the site's buy buttons from search: the pages that earn the money were precisely
 * the ones search could not reach. They are not thin. Each carries a synopsis, verified
 * dates, its themes, its difficulty, which of the nine programs assign it, a named
 * recommended edition and, for most, a verified ISBN, which is more than a great many
 * pages that rank. A guide makes the page better; it does not make it legitimate.
 */
const isStub = d.status === 'stub';
/*
 * What search knows about this page. Filters carry ids so the browse island's facet
 * state maps onto them one to one (see facetsToFilters in lib/search.ts); meta carries
 * the words a result shows. The facts and the assignments are in the index as words too,
 * at a low weight, so "demanding Greek epic" or "St. John's sophomore" finds this book
 * even though the facts block itself is excluded to keep excerpts clean.
 */
const mine = assigned.get(work.id) ?? [];
const searchFilters: [string, string][] = [
  ['era', d.era.id], ['genre', d.genre.id], ...d.genres.map((g) => ['genre', g.id] as [string, string]),
  ['language', d.language.id], ['region', d.region.id], ['author', author.id],
  ['difficulty', String(d.difficulty)], ['length', d.length], ['guide', hasGuideHere ? 'yes' : 'no'],
  ...d.themes.map((t) => ['theme', t.id] as [string, string]),
  ...[...new Set(mine.map((x) => x.program.id))].map((p) => ['program', p] as [string, string]),
  ...[...new Set(mine.map((x) => `${x.program.id}/${x.segment.id}`))].map((s) => ['segment', s] as [string, string]),
];
const searchMeta: [string, string][] = [
  ['type', 'Book'], ['author', author.data.name], ['slug', work.id], ['cover', og ?? ''], ['tone', toneFor(work.id).bg],
  ['year', yearLabel(work)], ['difficulty', String(d.difficulty)], ['length', d.length], ['pages', d.pages ? String(d.pages) : ''],
  ['era', era?.data.label ?? ''], ['genre', genre?.data.label ?? ''],
  ['themes', themeEntries.slice(0, 3).map((t) => `${t!.id}|${t!.data.label}`).join(', ')],
  ['guide', hasGuideHere ? 'yes' : 'no'], ['lists', String(count)],
];
const factWords = [era?.data.label, genre?.data.label, language?.data.label, lengthLabel[d.length], lengthHint[d.length], difficultyLabel(d.difficulty)].filter(Boolean).join(', ');
const assignmentWords = [...new Set(mine.flatMap((x) => [x.program.data.name, x.program.data.shortName, x.segment.label]))].join(', ');
const first = d.highlights[0];
const epigraph = first ? { text: first.text.length > 150 ? first.text.slice(0, 147).replace(/\s+\S*$/, '') + '…' : first.text, source: first.location } : undefined;
const description = d.synopsis.length > 158 ? d.synopsis.slice(0, 155).replace(/\s+\S*$/, '') + '…' : d.synopsis;
const langCode: Record<string, string> = { greek: 'grc', latin: 'la', hebrew: 'he', french: 'fr', german: 'de', italian: 'it', spanish: 'es', russian: 'ru' };
---
<Base title={`${d.title} by ${author.data.name}`} description={description} type="book" image={og}
  noindex={!hasGuideHere}
  jsonld={[bookLd(work, author, og ? new URL(og, Astro.site).toString() : undefined), breadcrumbs([{ name: 'Books', path: '/books/' }, { name: d.title, path: workUrl(work.id) }])]}>
  <article class="work" data-pagefind-body data-pagefind-filter="type:Book" data-work-view={work.id} data-work-guide={hasGuideHere ? "yes" : "no"} data-work-lists={String(count)}>
    {searchMeta.map(([k, v]) => <span class="visually-hidden" data-pagefind-meta={`${k}:${v}`}></span>)}
    {searchFilters.map(([k, v]) => <span class="visually-hidden" data-pagefind-filter={`${k}:${v}`}></span>)}
    <header class="wrap work__hero">
      <div class="work__head page-open">
        <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
          <ol><li><a href={url('/')}>The Great Books</a></li><li><a href={url('/books/')}>All books</a></li></ol>
        </nav>
        <h1 data-pagefind-meta="title" data-pagefind-weight="10">{d.title}</h1>
        {d.subtitle && <p class="work__subtitle" data-pagefind-weight="4">{d.subtitle}</p>}
        <p class="work__by">by <a href={authorUrl(author.id)} data-pagefind-weight="7">{author.data.name}</a>{d.originalTitle && <span class="work__orig"> · <span lang={langCode[d.language.id]}>{d.originalTitle}</span></span>}</p>
        {count > 0 && <p class="work__assigned" data-pagefind-ignore>Assigned by <strong>{count}</strong> of the 9 reading lists{hasGuideHere ? '' : ', catalogue entry only'}</p>}
        <dl class="work__facts ui" data-pagefind-ignore>
          <div><dt>Written</dt><dd>{yearLabel(work)}</dd></div>
          <div><dt>Era</dt><dd><a href={taxUrl('eras', d.era.id)}>{era?.data.label}</a></dd></div>
          <div><dt>Form</dt><dd><a href={taxUrl('genres', d.genre.id)}>{genre?.data.label}</a></dd></div>
          <div><dt>Language</dt><dd>{language?.data.label}</dd></div>
          <div><dt>Length</dt><dd>{lengthLabel[d.length]}{d.pages && <span class="work__pages"> · {d.pages} pp</span>}<span class="work__gloss-note">{lengthHint[d.length]}</span></dd></div>
          <div><dt>Difficulty</dt><dd><span class="dots" aria-hidden="true">{[1, 2, 3, 4, 5].map((i) => <i class:list={{ on: i <= d.difficulty }}></i>)}</span> {difficultyLabel(d.difficulty)}<span class="work__gloss-note">{d.difficulty} of 5 for a first-year reader</span></dd></div>
        </dl>
        <div id="buy-inline" class="set-hold" data-pagefind-ignore><BuyButtons work={work} authorName={author.data.name} /></div>
        <p class="work__synopsis" style="--i:3">{d.synopsis}</p>
      </div>
      <div class="work__stage" style={tint || undefined} data-pagefind-ignore>
        <FormPattern family={family} id="form-stage" class="work__texture" />
        <Book3D work={work} authorName={author.data.name} width={230} as="button" tilt openable eager epigraph={epigraph} endpaper={family} />
      </div>
    </header>

    <div class="wrap work__grid">
      <div class="work__main">
        {isStub ? (
          <section class="work__stub">
            <h2 class="work__h">No reading guide yet</h2>
            <p>The catalogue entry above is complete: the dates, the form, the themes and every program that assigns <em>{d.title}</em> are verified against each program's published list.</p>
            <p>What is missing is the part that takes real work: the summary, the key passages, and a recommended translation. {hasNamedEdition
              ? <>The edition named below is the one most programs assign, so the buy links are useful already.</>
              : <>That includes a recommended translation, so for now the buy links search the retailer rather than pointing at a chosen edition.</>}</p>
            <p class="work__stub-out"><a href={url('/books/') + '?guide=yes'}>Browse the {guided} works that do have a guide →</a></p>
          </section>
        ) : (
          <>
            {d.whyItMatters && (
              <section class="work__why">
                <h2 class="work__h">Why it's on the list</h2>
                <p class="work__why-text">{d.whyItMatters}</p>
              </section>
            )}
            {keyThemeEntries.length > 0 && (
              <section>
                <h2 class="work__h">Key themes</h2>
                <dl class="themes">
                  {keyThemeEntries.map((k) => (
                    <div class="themes__item">
                      <dt><a href={taxUrl('themes', k.theme.id)}>{k.entry?.data.label}</a></dt>
                      <dd>{k.note}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}
            <section class="prose work__body">
              <Content />
            </section>
            {d.highlights.length > 0 && (
              <section class="highlights">
                <h2 class="work__h">Highlights</h2>
                <ol class="highlights__list">
                  {d.highlights.map((h) => (
                    <li>
                      <blockquote>
                        <p>{h.text}</p>
                        <footer class="ui">{[h.location, h.translator && `trans. ${h.translator}`].filter(Boolean).join(' · ')}</footer>
                      </blockquote>
                      {h.note && <p class="highlights__note">{h.note}</p>}
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </>
        )}
        {/* Other names for the book and its author rank near the title; keywords, the
            facts and the assignments are findable but never outrank the guide itself. */}
        <span class="visually-hidden" data-pagefind-weight="3">{[d.originalTitle, ...d.aliases, ...author.data.aliases].filter(Boolean).join(', ')}</span>
        <span class="visually-hidden" data-pagefind-weight="0.6">{[...d.keywords, factWords, assignmentWords].filter(Boolean).join(', ')}</span>
      </div>

      <aside class="work__side" aria-labelledby="side-h" data-pagefind-ignore>
        <h2 class="visually-hidden" id="side-h">Where this book sits</h2>
        <section>
          <h3 class="side__h">Assigned in</h3>
          <ProgramBadges slug={work.id} />
        </section>
        <section>
          <h3 class="side__h">Themes</h3>
          <ul class="chips">{themeEntries.map((t) => t && <li><a class="tag tag--theme" href={taxUrl('themes', t.id)}>{t.data.label}</a></li>)}</ul>
        </section>
        <section>
          <h3 class="side__h">Tags</h3>
          <ul class="chips">
            <li><a class="tag tag--facet" href={taxUrl('genres', d.genre.id)}>{genre?.data.label}</a></li>
            {d.genres.map((g) => <li><a class="tag tag--facet" href={taxUrl('genres', g.id)}>{g.id.replace(/-/g, ' ')}</a></li>)}
            <li><a class="tag tag--facet" href={taxUrl('eras', d.era.id)}>{era?.data.label}</a></li>
            <li><a class="tag tag--facet" href={url(`/books/`) + `?region=${d.region.id}`}>{region?.data.label}</a></li>
            <li><a class="tag tag--facet" href={url(`/books/`) + `?language=${d.language.id}`}>{language?.data.label}</a></li>
            <li><a class="tag tag--facet" href={url(`/books/`) + `?difficulty=${d.difficulty}`}>{difficultyLabel(d.difficulty)}</a></li>
            <li><a class="tag tag--facet" href={url(`/books/`) + `?length=${d.length}`}>{lengthLabel[d.length]}</a></li>
          </ul>
        </section>
        {d.otherEditions.length > 0 && (
          <section>
            <h3 class="side__h">Other editions</h3>
            <ul class="editions ui">{d.otherEditions.map((e) => <li>{e.title ?? d.title}{e.translator && `, trans. ${e.translator}`}{e.publisher && ` (${e.publisher})`}{e.why && <span class="editions__why"> {e.why}</span>}</li>)}</ul>
          </section>
        )}
      </aside>
    </div>

    <div class="buybar" id="buybar" data-pagefind-ignore hidden>
      <span class="buybar__what">
        <span class="buybar__title">{d.title}</span>
        <span class="buybar__ed">{d.recommendedEdition?.translator ? `${d.recommendedEdition.translator} translation` : 'No edition recommended yet'}</span>
      </span>
      <a class="btn btn--accent buybar__cta" href={amazonUrl({ title: d.recommendedEdition?.title ?? d.title, author: author.data.name, isbn13: d.recommendedEdition?.isbn13, asin: d.recommendedEdition?.asin })}
         target="_blank" rel="sponsored noopener" data-affiliate="amazon" data-work={work.id}>Buy the book<span class="visually-hidden">&#32;{d.title} on Amazon, opens in a new tab</span></a>
    </div>

    {related.length > 0 && (
      <section class="wrap related" data-pagefind-ignore>
        <h2 class="work__h">Read next</h2>
        <div class="shelf-grid shelf-open">
          {related.map((r, i) => <BookCard work={r} authorName={(authors.get(r.data.author.id) ?? placeholderAuthor(r.data.author.id)).data.name} width={120} index={i} />)}
        </div>
      </section>
    )}
  </article>
</Base>
<style>
    /* The hero and the body below it are the same two columns: everything written sits in
     one wide column at the page gutter, and the right rail holds the object and the facts
     about it. Before this the title started two fifths across and the guide underneath it
     started at the gutter, so the page had two left edges. */
  .work__hero {
    /* The texture behind the book reaches past the column by design; past the edge of a
       phone screen it would widen the page instead. */
    overflow-x: clip;
    display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--s4);
    padding-block: var(--s4) var(--s3); align-items: start;
  }
  /* :global, because the cover belongs to Book3D. Astro scopes this stylesheet's selectors
     with this page's own cid, and .book__front carries Book3D's, so the plain selector
     compiled to .book__front[data-astro-cid-htmgan3m] and matched nothing. The destination
     therefore had no transition name at all: the browser had an outgoing snapshot and
     nothing to morph it into, so the cover sat still and faded out while the page changed
     under it. That is the whole reason the eye was left hunting. */
  /* Only while the book is shut. A view-transition-name flattens its element into one
     plane, so on an opened cover the jacket was drawn from behind, mirrored, where the
     endpaper should be. A page transition only ever captures the book shut anyway. */
  .work__stage :global(.book[data-state='shelf'] .book__front) { view-transition-name: book-cover; }
  .work__stage { grid-column: 2; grid-row: 1; position: sticky; top: var(--stick); align-self: start; display: grid; justify-items: center; gap: var(--s2); padding-bottom: var(--s1); max-height: var(--stick-max); }
  /* The form of the work, as a texture on the wall the book stands against: verse ruled in
     lines, a play in arches, an argument in compass work. Coloured by the jacket where it
     has a colour, and faint enough that it is noticed on the second book, not the first.
     z-index -2 keeps it behind the book inside the stage, which is positioned. */
  .work__stage :global(.work__texture) {
    position: absolute; top: -10%; left: 50%; translate: -50% 0;
    width: min(170%, 34rem); aspect-ratio: 0.86; height: auto; max-width: none;
    z-index: -2; pointer-events: none;
    color: oklch(var(--tint-l, 0.5) calc(var(--tint-c, 0) * 0.8) var(--tint-h, 0));
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 46%, #000 18%, rgb(0 0 0 / 0.4) 46%, transparent 72%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 46%, #000 18%, rgb(0 0 0 / 0.4) 46%, transparent 72%);
    opacity: 0.34;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .work__stage :global(.work__texture) { opacity: 0.4; } }
  :root[data-theme='dark'] .work__stage :global(.work__texture) { opacity: 0.4; }
  @media (prefers-reduced-motion: no-preference) {
    .work__stage :global(.work__texture) { animation: texture-in 1200ms var(--ease-out) 200ms backwards; }
    @keyframes texture-in { from { opacity: 0; } }
  }
  .work__head { grid-column: 1; grid-row: 1; display: grid; gap: var(--s1); align-content: start; min-width: 0; }
  .work__head h1 { font-style: italic; font-size: var(--step-4); line-height: var(--lh-title); letter-spacing: var(--tracking-display); }
    /* A subtitle belongs to the title above it, not to the byline below, so it closes up. */
  .work__subtitle { font-size: var(--step-1); color: var(--ink-soft); font-style: italic; margin-top: calc(var(--s-1) - var(--s1)); }
  .work__by { font-size: var(--step-1); color: var(--ink-soft); }
  .work__by a { color: var(--ink-strong); }
  .work__orig { color: var(--ink-mute); }
  .work__assigned { font-family: var(--font-ui); font-size: var(--step--1); color: var(--ink-soft); }
  .work__assigned strong { font-family: var(--font-display); font-size: var(--step-1); font-weight: var(--w-emph); color: var(--ink-strong); font-variant-numeric: tabular-nums; }
  .work__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s2); margin: 0; padding: var(--s2) 0; border-top: var(--rule-section); border-bottom: var(--rule); }
  @media (max-width: 620px) { .work__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    /* Only two of the six facts carry a second gloss line, so without shared rows the labels
     in the bottom row sat at a different height from the labels in the top row. */
  .work__facts { grid-auto-rows: auto; row-gap: var(--s2); }
  .work__facts div { grid-row: span 2; display: grid; grid-template-rows: subgrid; row-gap: var(--s-1); min-width: 0; }
  .work__facts dt { align-self: start; font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-mute); }
  .work__facts dd { margin: 0; color: var(--ink-strong); font-size: var(--step--1); }
  /* The link's box is taller than its text so a thumb can land on it (24px is the floor). */
  .work__facts dd a { text-decoration: none; display: inline-block; padding-block: 0.2em; margin-block: -0.2em; min-height: 24px; }
  .work__facts dd a:hover { color: var(--accent); }
  .work__pages { color: var(--ink-mute); }
  .work__gloss-note { display: block; color: var(--ink-mute); font-size: var(--step--2); letter-spacing: 0; text-transform: none; margin-top: var(--s-1); }
    /* Aligned to the label's x-height rather than to the line box. */
  .dots { display: inline-flex; gap: 3px; vertical-align: 0.02em; margin-right: 0.4em; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--edge); }
  .dots i.on { background: var(--accent); }
  .work__synopsis { font-size: var(--step-1); line-height: var(--lh-tight-prose); max-width: 60ch; text-wrap: pretty; }
  .work__grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--s4); padding-block: var(--s3); border-top: var(--rule); }
  .work__main { display: grid; gap: var(--s4); min-width: 0; }
  .work__h { font-style: italic; font-size: var(--step-2); margin-bottom: var(--s2); }
  .work { --fold: 0; }
  .work__why { padding-block: var(--s2); border-top: var(--rule-section); }
  .work__why-text { font-size: var(--step-1); line-height: var(--lh-tight-prose); max-width: var(--measure); text-wrap: pretty; }
    /* Theme names and their notes each keep their own band across the row. */
  .themes { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); grid-auto-rows: auto; gap: var(--s2) var(--s3); margin: 0; }
  .themes__item { grid-row: span 2; display: grid; grid-template-rows: subgrid; row-gap: var(--s-1); min-width: 0; }
  .themes__item dt { font-size: var(--step-1); }
  .themes__item dt a { text-decoration: none; border-bottom: 1px solid var(--accent); }
  .themes__item dd { margin: 0; color: var(--ink-soft); line-height: var(--lh-prose); max-width: 46ch; }
  .highlights__list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s3); }
  .highlights__list li { max-width: var(--measure); }
    /* The quotation's first letter, not its opening mark, lines up with the rule. */
  .highlights__list blockquote { margin: 0; padding-left: var(--s2); border-left: 1px solid var(--accent); font-size: var(--step-1); line-height: var(--lh-tight-prose); font-style: italic; color: var(--ink-strong); hanging-punctuation: first last; }
  .highlights__list blockquote footer { margin-top: var(--s0); color: var(--ink-mute); font-size: var(--step--2); font-style: normal; letter-spacing: 0.04em; }
  .highlights__note { margin-top: var(--s1); padding-left: var(--s2); color: var(--ink-soft); line-height: var(--lh-prose); max-width: 56ch; }
  .work__side {
    display: grid; gap: var(--s3); align-content: start; align-self: start;
    position: sticky; top: var(--stick); container-type: inline-size;
    /* A sticky panel taller than the viewport pins its own lower half out of reach. */
    max-height: var(--stick-max); overflow-y: auto; overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }
  .side__h { margin-bottom: var(--s1); font-family: var(--font-ui); font-size: var(--step--2); font-weight: var(--w-emph); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--ink-soft); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-1); }
    /* Markers hang in the margin so the editions keep the sidebar's left edge. */
  .editions { margin: 0; padding-left: 0; color: var(--ink-soft); display: grid; gap: var(--s0); font-size: var(--step--2); }
  .editions li { margin-left: 1.1em; }
  .editions__why { color: var(--ink-mute); }
  .related { padding-top: var(--s4); border-top: var(--rule); }
  .work__stub { display: grid; gap: var(--s1); max-width: var(--measure); }
  .work__stub p { color: var(--ink-soft); line-height: 1.6; }
  .work__stub-out { margin-top: var(--s1); }
