---
/**
 * Temporary type specimen. Not linked, not indexed, not in the sitemap.
 * Delete this page once a pairing is chosen and self-hosted.
 *
 * Fonts load from Google Fonts and Fontshare here on purpose: this is a comparison, and
 * self-hosting five families to audition them would be wasted work. The winner gets
 * self-hosted via fontsource (or Fontshare's files) so the live site keeps loading nothing
 * from a third party.
 */
const OPTIONS = [
  {
    id: 'current',
    name: 'Cormorant Garamond + DM Sans',
    tag: 'What you have now',
    display: "'Cormorant Garamond', Georgia, serif",
    text: "'Cormorant Garamond', Georgia, serif",
    ui: "'DM Sans', system-ui, sans-serif",
    note: 'Beautiful at huge sizes. The reason to move: it is one of the most used faces on the web, and its very high contrast goes thin and hazy at reading size, which is most of this site.',
  },
  {
    id: 'fraunces',
    name: 'Fraunces + DM Sans',
    tag: 'The most characterful',
    display: "'Fraunces', Georgia, serif",
    text: "'Fraunces', Georgia, serif",
    ui: "'DM Sans', system-ui, sans-serif",
    note: 'Has an optical-size axis, so the display cut is dramatic and the text cut quietly thickens to stay readable. Also carries SOFT and WONK axes, which give it that slightly antique wobble. Strong personality, so it is the riskiest of the four.',
  },
  {
    id: 'newsreader',
    name: 'Newsreader',
    tag: 'One family, top to bottom',
    display: "'Newsreader', Georgia, serif",
    text: "'Newsreader', Georgia, serif",
    ui: "'Newsreader', Georgia, serif",
    note: 'Drawn for reading on screens, with an optical-size axis and a genuinely lovely italic. Using one family for everything is a real position: it would make the site feel like a book rather than a product.',
  },
  {
    id: 'literata',
    name: 'Literata + DM Sans',
    tag: 'The most readable',
    display: "'Literata', Georgia, serif",
    text: "'Literata', Georgia, serif",
    ui: "'DM Sans', system-ui, sans-serif",
    note: 'Commissioned for Google Play Books, so it is engineered for exactly what this site asks: long stretches of prose on a screen. Sturdier and less showy than the others.',
  },
  {
    id: 'gambetta',
    name: 'Gambetta + Satoshi',
    tag: 'The most unusual',
    display: "'Gambetta', Georgia, serif",
    text: "'Gambetta', Georgia, serif",
    ui: "'Satoshi', system-ui, sans-serif",
    note: 'From Fontshare. Calligraphic, with a written quality that suits a canon running back to manuscripts. Rare on the web. Static weights only, so no optical sizing.',
  },
];
const GUIDE = `The Iliad covers a few weeks near the end of a ten-year war, and it leaves out the war's most famous episodes. There is no judgement of Paris, no wooden horse, no fall of the city. What it covers instead is a quarrel between two Greeks and everything that follows from it.`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Type specimen · The Great Books</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&family=Literata:ital,opsz,wght@0,7..72,300..800;1,7..72,300..800&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link href="https://api.fontshare.com/v2/css?f[]=gambetta@400,401,700&f[]=satoshi@400,500,700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --paper: #f2e8e4; --ink: #4b4644; --ink-strong: oklch(0.22 0.012 40);
        --ink-soft: oklch(0.46 0.015 40); --ink-mute: oklch(0.515 0.014 45);
        --accent: #ff4c00; --accent-deep: oklch(0.52 0.19 37);
        --rule: 1px dotted color-mix(in oklch, var(--ink) 26%, transparent);
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); -webkit-font-smoothing: antialiased; }
      .wrap { width: min(100% - 3rem, 52rem); margin-inline: auto; }
      .intro { padding: 3rem 0 1rem; font-family: 'DM Sans', system-ui, sans-serif; }
      .intro h1 { font-size: 1.1rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); margin: 0 0 0.75rem; font-weight: 600; }
      .intro p { margin: 0; color: var(--ink-soft); max-width: 46ch; line-height: 1.6; font-size: 0.95rem; }

      .spec { padding: 2.5rem 0 3rem; border-top: var(--rule); }
      .spec__bar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; margin-bottom: 1.75rem; font-family: 'DM Sans', system-ui, sans-serif; }
      .spec__name { font-size: 0.95rem; font-weight: 600; color: var(--ink-strong); }
      .spec__tag { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-deep); }
      .spec__note { font-family: 'DM Sans', system-ui, sans-serif; font-size: 0.86rem; line-height: 1.65; color: var(--ink-soft); max-width: 58ch; margin-top: 1.5rem; }

      .h1 { font-size: clamp(2.2rem, 8vw, 4.2rem); line-height: 1; letter-spacing: -0.02em; margin: 0; display: grid; justify-items: start; font-weight: 500; }
      .h1 em { color: var(--accent-deep); font-style: italic; }
      .lede { font-size: 1.1rem; line-height: 1.5; color: var(--ink-soft); max-width: 44ch; margin: 1.1rem 0 0; }
      .h2 { font-size: 1.7rem; font-style: italic; font-weight: 500; margin: 2rem 0 0.6rem; }
      .body { font-size: 1.08rem; line-height: 1.6; max-width: 66ch; margin: 0; }
      .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin-top: 1.4rem; align-items: baseline; }
      .meta__title { font-size: 1.05rem; color: var(--ink-strong); }
      .meta__sub { font-size: 0.8rem; color: var(--ink-soft); letter-spacing: 0.02em; }
      .meta__label { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); }
    </style>
  </head>
  <body>
    <div class="wrap intro">
      <h1>Type specimen</h1>
      <p>The same five pieces of the real site, set five ways: the headline, the lede, a section heading, a paragraph of an actual reading guide, and the card metadata. Look at the paragraph hardest. That is what most of the site is.</p>
    </div>

    {OPTIONS.map((o) => (
      <section class="spec">
        <div class="wrap">
          <div class="spec__bar">
            <span class="spec__name">{o.name}</span>
            <span class="spec__tag">{o.tag}</span>
          </div>

          <h2 class="h1" style={`font-family:${o.display}`}>
            <span>Three thousand years</span>
            <span>of <em>rebellion</em></span>
          </h2>
          <p class="lede" style={`font-family:${o.text}`}>
            The ideas that built the West, argued out in the books themselves. 689 works, nine reading lists, a guide to each.
          </p>

          <h3 class="h2" style={`font-family:${o.display}`}>Why it's on the list</h3>
          <p class="body" style={`font-family:${o.text}`}>{GUIDE}</p>

          <div class="meta">
            <span class="meta__title" style={`font-family:${o.display}`}>The Iliad</span>
            <span class="meta__sub" style={`font-family:${o.ui}`}>Homer · c. 750 BCE</span>
            <span class="meta__label" style={`font-family:${o.ui}`}>On 8 lists</span>
          </div>

          <p class="spec__note">{o.note}</p>
        </div>
      </section>
    ))}
  </body>
</html>
