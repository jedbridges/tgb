---
/**
 * The seal, in wax.
 *
 * What this replaced, and why. The previous seal was a blind deboss: no ink, no object,
 * just the paper pressed, on the argument that an object in the corner of the hero has to
 * win against the headline or lose to it. That argument was sound and it has been
 * overruled on purpose. A deboss can only ever be a texture, and the mark is the thing
 * that says a person chose these books; it earns being an object. So this is wax, poured
 * and struck, and it is lit rather than drawn.
 *
 * Three things are worth knowing.
 *
 * The shape is shared. src/lib/seal-geometry.ts holds every radius, height and
 * coefficient, and hands the same numbers to this SVG, to the shader, and to the script
 * that lays the legend out. There is no second copy to drift.
 *
 * What ships in the HTML is this SVG, and it is complete: a reader with no JavaScript, no
 * WebGL, a lost context, a print dialog or a forced-colours mode sees a finished seal
 * rather than a hole. The canvas is created by script, fades in over the top, and the SVG
 * stays underneath for the rest of the page's life. The relief is rasterised out of these
 * very nodes, so the two cannot disagree about where a letter sits.
 *
 * There is no filter element anywhere in here, and nothing inside the SVG animates. Those
 * two together, on this page, once held Safari at six frames a second: an SVG filter with
 * something moving inside it is re-run on the CPU every frame. The smoke test now fails
 * the build if a filter reappears in this markup.
 *
 * The legend reads IN PRINCIPIO ERAT VERBUM, twice, hinged on the Greek word the Latin is
 * translating. Outlines are baked at build time by scripts/build-seal.ts, from EB Garamond
 * SemiBold (SIL OFL 1.1), because neither face this site ships has a Greek capital in it.
 */
import legend from '~/assets/seal-legend.json';
import { MARK_PATHS } from '~/lib/mark';
import {
  outlinePath, FIELD_C, R_FIELD, R_LIP, DEVICE_TRANSFORM, LEGEND,
} from '~/lib/seal-geometry';

interface Props { class?: string }
const { class: cls } = Astro.props;

const OUTLINE = outlinePath();
const gid = (ch: string) => `sg${ch.codePointAt(0)}`;
const shapes = Object.entries(legend.glyphs as Record<string, string>);
const place = legend.place as Array<[string, string]>;
---
<div class:list={['seal', cls]} data-seal aria-hidden="true">
  <!-- The shader works in linear light and needs real numbers, but a custom property
       computes to whatever token it was written as and a computed colour may serialise as
       oklch(). So the colours are put on something and read back off it. -->
  <span class="seal__probe" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

  <svg class="seal__svg" viewBox="0 0 400 400" role="presentation" focusable="false">
    <defs>
      <radialGradient id="wax-body" cx="42%" cy="38%" r="72%">
        <stop class="s-edge" offset="0" />
        <stop class="s-wax" offset="0.55" />
        <stop class="s-deep" offset="1" />
      </radialGradient>
      <radialGradient id="wax-shadow" cx="50%" cy="50%" r="50%">
        <stop class="s-shadow" offset="0.86" />
        <stop class="s-shadow-out" offset="0.98" />
      </radialGradient>
      <linearGradient id="wax-lip" x1="0" y1="0" x2="1" y2="1">
        <stop class="s-edge" offset="0" stop-opacity="0.7" />
        <stop class="s-wax" offset="0.5" stop-opacity="0" />
        <stop class="s-deep" offset="1" stop-opacity="0.6" />
      </linearGradient>
      <linearGradient id="wax-field" x1="0" y1="0" x2="0.6" y2="1">
        <stop class="s-deep" offset="0" />
        <stop class="s-wax" offset="1" />
      </linearGradient>
      <!-- A recess lit from over the left shoulder has its near wall in shade and its far
           wall catching the light, which is the whole of what tells an eye it is sunk. -->
      <linearGradient id="wax-wall" x1="0" y1="0" x2="0.8" y2="1">
        <stop class="s-deep" offset="0" />
        <stop class="s-edge" offset="1" />
      </linearGradient>
      {shapes.map(([ch, d]) => <path id={gid(ch)} d={d} />)}
    </defs>

    <path class="seal__shadow" d={OUTLINE} transform="translate(5 8) scale(1.04)" fill="url(#wax-shadow)" />
    <path class="seal__body" d={OUTLINE} fill="url(#wax-body)" />
    <circle cx={FIELD_C[0]} cy={FIELD_C[1]} r={R_LIP} fill="none" stroke="url(#wax-lip)" stroke-width="11" />
    <circle cx={FIELD_C[0]} cy={FIELD_C[1]} r={R_FIELD} fill="url(#wax-field)" />
    <circle cx={FIELD_C[0]} cy={FIELD_C[1]} r={R_FIELD - 1.2} fill="none" stroke="url(#wax-wall)" stroke-width="2.4" />

    <!-- The raised work. data-h is how proud each part stands, which is what the relief
         rasteriser reads: the device full, the legend a little lower, so the mark keeps
         the deeper cut where a letter passes near it. -->
    <g id="seal-relief">
      <g class="seal__legend" transform={`translate(${FIELD_C[0]},${FIELD_C[1]})`}>
        {place.map(([ch, m]) => <use href={`#${gid(ch)}`} transform={m} data-h="215" />)}
      </g>
      <g class="seal__device" transform={DEVICE_TRANSFORM}>
        {MARK_PATHS.map((d) => <path d={d} data-h="255" />)}
      </g>
    </g>
  </svg>
</div>

<style>
  /* Wax is a material, not a user-interface red.
     tokens.css asks that no file mix its own red, so the light value is --accent-press
     exactly. The dark value is deliberately not that token's own dark half: --accent-press
     goes pale pink in the dark scheme, which is right for a pressed button and quite wrong
     for wax, because a stick of sealing wax does not change colour when the light does. It
     sits on darker paper with a little less chroma, and that is all. */
  .seal {
    --wax:      light-dark(oklch(0.42 0.17 35), oklch(0.39 0.15 33));
    --wax-deep: light-dark(oklch(0.30 0.13 31), oklch(0.27 0.11 30));
    --wax-edge: light-dark(oklch(0.55 0.19 39), oklch(0.50 0.17 37));
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .seal__probe { position: absolute; width: 0; height: 0; overflow: hidden; }
  .seal__probe i:nth-child(1) { color: var(--wax); }
  .seal__probe i:nth-child(2) { color: var(--wax-deep); }
  .seal__probe i:nth-child(3) { color: var(--wax-edge); }
  .seal__probe i:nth-child(4) { color: var(--paper); }

  .seal__svg, :global(.seal__gl) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    display: block; overflow: visible;
  }
  /* The canvas arrives over the top and the SVG goes out underneath it. Both are in the
     same square, so nothing on the page moves when the swap happens. */
  :global(.seal__gl) { opacity: 0; transition: opacity 320ms var(--ease-out); }
  .seal[data-gl] :global(.seal__gl) { opacity: 1; }
  .seal[data-gl] .seal__svg {
    opacity: 0; visibility: hidden;
    transition: opacity 320ms var(--ease-out), visibility 0s 320ms;
  }
  /* When the canvas is going to strike the wax itself, the drawn fallback leaves at once
     rather than fading, so the reader never sees a finished impression dissolve into an
     unfinished one. */
  .seal[data-press] .seal__svg { transition: none; }
  .seal[data-press] :global(.seal__gl) { transition: none; }

  .s-wax { stop-color: var(--wax); }
  .s-deep { stop-color: var(--wax-deep); }
  .s-edge { stop-color: var(--wax-edge); }
  .s-shadow { stop-color: rgb(var(--shadow-ink) / calc(0.22 * var(--shadow-a))); }
  .s-shadow-out { stop-color: rgb(var(--shadow-ink) / 0); }

  #seal-relief use, #seal-relief path { fill: var(--wax-edge); }
  /* The relief in the fallback is flat fill rather than modelled light. It is a drawing of
     a seal, not a photograph of one, and it only has to hold the half second before the
     canvas arrives, or the whole visit if the canvas never does. */
  .seal__device path { fill: color-mix(in oklab, var(--wax-edge), white 8%); }

  @media print {
    /* A canvas without a preserved drawing buffer can print as a blank square. */
    :global(.seal__gl) { display: none; }
    .seal[data-gl] .seal__svg { opacity: 1; visibility: visible; }
  }
  /* It carries no information, so in a forced palette it simply steps out of the way
     rather than becoming a solid shape in somebody's chosen colours. */
  @media (forced-colors: active) { .seal { display: none; } }

  @media (prefers-reduced-motion: no-preference) {
    .seal { animation: seal-strike 820ms cubic-bezier(0.16, 1, 0.3, 1) 220ms backwards; }
    @keyframes seal-strike {
      from { opacity: 0; transform: translateY(-14px) scale(1.06); }
      70% { opacity: 1; }
      to { opacity: 1; transform: none; }
    }
  }
</style>

<script>
  /* The renderer is loaded on idle, not on parse. It is the one piece of this page that
     nothing depends on: the seal is already drawn and already correct when this runs, so
     it waits until the browser has nothing better to do and then upgrades. The import is
     dynamic so none of the GL code sits in the critical bundle. */
  const root = document.querySelector<HTMLElement>('[data-seal]');
  if (root && typeof WebGLRenderingContext !== 'undefined') {
    /* Started after the first paint, not on idle.
       On idle was the cautious choice and it cost the entrance: by the time the browser
       declares itself idle the page is a second old and striking the wax then looks like
       a glitch rather than an arrival. One frame after paint is late enough to stay off
       the critical path and early enough that the press belongs to the page opening. */
    const boot = () => import('~/lib/seal-gl').then((m) => m.mountWaxSeal(root)).catch(() => { /* the SVG stands */ });
    requestAnimationFrame(() => requestAnimationFrame(boot));
  }
</script>
