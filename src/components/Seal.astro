---
/**
 * The seal.
 *
 * Not an object on the page. The page itself, pressed.
 *
 * A blind deboss is what a bindery does to a cloth cover when it wants a mark without ink:
 * a heated die is struck into the board, and what you see afterwards is not pigment but
 * light, caught on the wall of the recess. That is the whole of this component. There is no
 * gold, no disc, no material that the site does not already have. Every line here is warm
 * paper with a shadow above it and a highlight below it, which is exactly what a pressed
 * line looks like under a light that comes from overhead.
 *
 * Why this rather than a rendered medallion: an object has to win against the headline or
 * lose to it, and at this size it was winning. A deboss is the surface, so it can run off
 * the edge of the screen at any scale without competing with a word.
 *
 * Three things are worth knowing about the construction.
 *
 * The strike is three copies of one drawing. A dark copy sits a little high, a light copy a
 * little low, and the real one on top is filled with the page's own paper, so only the two
 * lips survive. Both lips are softened by a small blur, because a die leaves a rolled edge
 * rather than a cut one.
 *
 * The recess cannot be pure paper. A true same-value deboss relies on a real light and a
 * real surface; on a screen, under a grain overlay, it disappears. The face carries a few
 * per cent of ink so the pressed area reads as sunk even on a phone in daylight. That is a
 * cheat, and it is the difference between debossed and absent.
 *
 * The rim turns. The lettering rotates inside the ring while the seal itself stays put,
 * slowly enough that it reads as drift rather than as a spinner. The rotation has to be
 * applied inside the lip offset, not outside it, or the shadow travels around to the bottom
 * of the letters: hence a translating group wrapping a rotating use, rather than one
 * element carrying both.
 *
 * On hover an iridescence rises in the struck lines only, the way light moves over a foil
 * that has been pressed rather than printed. It is one gradient, turned by the pointer.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;

const RIM = '· EVERY BOOK THAT NINE PROGRAMS ASSIGN · ONE SHELF ';

/* The scalloped edge, as arcs rather than as a polygon: twenty-six chords, each bulged
   outward by a fixed sagitta. Soft lobes, not teeth. A sunburst edge reads as a discount
   sticker; this one reads as a notary seal, which is the claim being made. */
const LOBES = 26;
const EDGE_R = 170;
const BULGE = 8;
const chord = 2 * EDGE_R * Math.sin(Math.PI / LOBES);
const arcR = (chord * chord) / 4 / (2 * BULGE) + (BULGE * BULGE) / (2 * BULGE);
const n = (v: number) => Number(v.toFixed(2));
const ring = Array.from({ length: LOBES + 1 }, (_, i) => {
  const t = -Math.PI / 2 + (i * 2 * Math.PI) / LOBES;
  return [n(200 + EDGE_R * Math.cos(t)), n(200 + EDGE_R * Math.sin(t))] as const;
});
const SCALLOP =
  `M${ring[0][0]},${ring[0][1]}` +
  ring.slice(1).map(([x, y]) => `A${n(arcR)},${n(arcR)} 0 0,1 ${x},${y}`).join('') +
  'Z';

const RIM_R = 134;
const RIM_LEN = n(2 * Math.PI * RIM_R);
---
<div class:list={['seal', cls]} data-seal aria-hidden="true">
  <div class="seal__sheen"></div>
  <svg class="seal__art" viewBox="0 0 400 400" role="presentation" focusable="false">
    <defs>
      <!-- Everything that does not turn. -->
      <g id="seal-still">
        <path d={SCALLOP} fill="none" stroke-width="2.6" />
        <circle cx="200" cy="200" r="161" fill="none" stroke-width="1.1" />
        <circle cx="200" cy="200" r="155" fill="none" stroke-width="1.1" />
        <circle cx="200" cy="200" r="108" fill="none" stroke-width="1.1" />
        <!-- The mark, where a seal carries its device. -->
        <g transform="translate(144.5, 158) scale(0.0661)">
          <path d="M1681.625,391.685c-220.914-220.913-579.086-220.913-800,0v-226c220.914-220.913,579.086-220.913,800,0Z" />
          <path d="M1681.625,965.685c-220.914-220.914-579.086-220.914-800,0v-226c220.914-220.914,579.086-220.914,800,0Z" />
          <path d="M1681.625,678.685c-220.914-220.914-579.086-220.914-800,0v-226c220.914-220.914,579.086-220.914,800,0Z" />
          <path d="M800,965.685c-220.914-220.914-579.086-220.914-800,0v-800c220.914-220.913,579.086-220.913,800,0Z" />
        </g>
        <text class="seal__count" x="200" y="252">689 WORKS</text>
        <path d="M168,266 H232" stroke-width="1.3" fill="none" />
      </g>

      <!-- Everything that does. -->
      <g id="seal-turn">
        <path id="seal-rim-path" d={`M200,200 m-${RIM_R},0 a${RIM_R},${RIM_R} 0 1,1 ${RIM_R * 2},0 a${RIM_R},${RIM_R} 0 1,1 -${RIM_R * 2},0`} fill="none" />
        <text class="seal__rim">
          <textPath href="#seal-rim-path" startOffset="0" textLength={RIM_LEN} lengthAdjust="spacing">{RIM}</textPath>
        </text>
      </g>
    </defs>

    <!-- The sunk area itself. A recess gathers a little shade before any lip is drawn. -->
    <path class="seal__recess" d={SCALLOP} />

    <!-- The strike. Dark lip high, light lip low, face in the page's own paper.
         Each lip translates on the outside of a use that rotates on the inside, so the
         lettering turns while the direction of the light does not. -->
    <g class="seal__lip seal__lip--dark" transform="translate(0,-2.5)">
      <use href="#seal-still" />
      <use href="#seal-turn" class="seal__spin" />
    </g>
    <g class="seal__lip seal__lip--light" transform="translate(0,2.5)">
      <use href="#seal-still" />
      <use href="#seal-turn" class="seal__spin" />
    </g>
    <g class="seal__face">
      <use href="#seal-still" />
      <use href="#seal-turn" class="seal__spin" />
    </g>
  </svg>
</div>

<style>
  .seal {
    /* The press. Two schemes, not one flipped: a recess in dark paper needs a far weaker
       highlight than one in light paper, or the lip reads as an outline drawn around the
       shape rather than as light falling into it. */
    --press-dark: light-dark(rgb(74 58 50 / 0.56), rgb(0 0 0 / 0.72));
    --press-light: light-dark(rgb(255 255 253 / 1), rgb(255 244 228 / 0.13));
    --press-recess: light-dark(rgb(74 58 50 / 0.030), rgb(0 0 0 / 0.11));
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .seal__art { width: 100%; height: 100%; display: block; overflow: visible; }

  .seal__recess { fill: var(--press-recess); }

  /* No blur on the lips. A softened edge is truer to a die strike, but it cost an SVG
     filter, and an SVG filter with something turning inside it is re-run on the CPU every
     frame: measured in Safari it held the whole page at 26fps with the filter alone and
     6fps with the sheen as well. The lips carry a little less weight instead, which reads
     as the same shallow press without asking anything of the compositor. */
  .seal__lip--dark * { fill: var(--press-dark); stroke: var(--press-dark); }
  .seal__lip--light * { fill: var(--press-light); stroke: var(--press-light); }
  /* The face is the page. It exists only to bury the middle of each lip, which is what
     turns two offset copies into one pressed line. */
  .seal__face * { fill: var(--paper); stroke: var(--paper); }

  /* The sheen.
     It used to be a fourth copy of every struck line, painted with an SVG gradient, so the
     iridescence sat inside the lettering itself. That was the nicest version and it is not
     affordable: its mere presence, blending or not, turning or not, held Safari at 6fps.
     One CSS layer over the disc instead. It is composited rather than rasterised, so it
     costs nothing until the pointer arrives, and it catches the whole medallion rather than
     only its lines, which is what light on a foil does anyway. */
  .seal__sheen {
    position: absolute; inset: 5.4%;
    border-radius: 50%;
    pointer-events: none;
    opacity: calc(var(--sheen, 0) * 0.85);
    /* A band, not a disc. A conic sweep covers every pixel of the medallion, which on
       parchment passes for a sheen and on a dark page is simply a milky film laid over the
       whole thing: the deboss disappears under it. A band that is transparent at both ends
       leaves most of the seal alone and reads as light travelling across a surface, which
       is what it is. The element is a circle, so turning it toward the pointer turns the
       band and nothing else, and a rotation is composited rather than repainted. */
    background: linear-gradient(to right,
      transparent 14%,
      rgb(246 221 192 / 0.40) 29%,
      rgb(207 232 224 / 0.52) 41%,
      rgb(217 210 238 / 0.58) 51%,
      rgb(242 214 223 / 0.52) 61%,
      rgb(248 238 214 / 0.38) 73%,
      transparent 88%);
    rotate: calc(var(--sweep, 0) * 1deg);
    transition: opacity 420ms var(--ease-out);
    will-change: opacity;
  }
  /* Light added to a near-black page carries much further than light added to paper. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .seal__sheen { opacity: calc(var(--sheen, 0) * 0.42); }
  }
  :root[data-theme='dark'] .seal__sheen { opacity: calc(var(--sheen, 0) * 0.42); }

  /* Bigger than it looks like it needs to be. A blind deboss carries no ink, so the only
     things holding a letter together are its size and the depth of the strike, and at 19.5
     the thin strokes of the rim legend were disappearing into the paper. */
  .seal__rim {
    font-family: var(--font-ui);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .seal__count {
    font-family: var(--font-ui);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-anchor: middle;
  }

  /* Drift, not rotation. A full turn takes well over a minute, so the eye reads it as the
     page breathing rather than as something loading. */
  .seal__spin { transform-box: view-box; transform-origin: 200px 200px; }
  @media (prefers-reduced-motion: no-preference) {
    .seal__spin { animation: seal-turn 78s linear infinite; }
    @keyframes seal-turn { to { rotate: 360deg; } }

    /* It arrives the way it was made: struck, from very slightly above. */
    .seal { animation: seal-strike 820ms cubic-bezier(0.16, 1, 0.3, 1) 220ms backwards; }
    @keyframes seal-strike {
      from { opacity: 0; transform: translateY(-14px) scale(1.06); }
      70% { opacity: 1; }
      to { opacity: 1; transform: none; }
    }
  }
</style>

<script>
  /*
   * The sheen, and only the sheen.
   *
   * Everything else is CSS and SVG. This reads the pointer across the hero and writes two
   * values: how much iridescence, by distance from the seal, and which way it runs. It
   * never runs without a real pointer, so a phone gets a still deboss, which is what a
   * deboss is.
   */
  const seal = document.querySelector<HTMLElement>('[data-seal]');
  const sheen = seal?.querySelector<HTMLElement>('.seal__sheen');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');

  if (seal && sheen && fine.matches) {
    let frame = 0;
    const rest = () => seal.style.setProperty('--sheen', '0');

    /* Geometry is measured once and re-measured only when it can actually have changed.
       Reading a bounding rect inside a pointermove handler forces a synchronous layout on
       every single mouse move, and on a page carrying a shelf of books that is not a free
       read: it is the whole reason a hover can feel like it is dragging. */
    const hero = seal.closest('section');
    let h: DOMRect | null = null;
    let r: DOMRect | null = null;
    const remeasure = () => { h = hero?.getBoundingClientRect() ?? null; r = seal.getBoundingClientRect(); };
    remeasure();
    addEventListener('resize', remeasure, { passive: true });
    addEventListener('scroll', remeasure, { passive: true });

    let px = 0, py = 0;
    addEventListener('pointermove', (e) => {
      px = e.clientX; py = e.clientY;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (!h || !r || !r.width) return;
        if (py < h.top || py > h.bottom) { rest(); return; }
        const dx = px - (r.left + r.width / 2);
        const dy = py - (r.top + r.height / 2);
        // Full strength on the seal, falling away over about a seal's width, so it lights up
        // as the pointer approaches rather than switching on at an edge.
        const near = Math.max(0, 1 - Math.hypot(dx, dy) / (r.width * 1.15));
        seal.style.setProperty('--sheen', near.toFixed(3));
        seal.style.setProperty('--sweep', String(Math.round((Math.atan2(dy, dx) * 180) / Math.PI)));
      });
    }, { passive: true });

    addEventListener('blur', rest);
    document.addEventListener('mouseleave', rest);
  }
</script>
