---
import { url } from '~/lib/url';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/books/', label: 'Books' },
  { href: '/programs/', label: 'Programs' },
  { href: '/authors/', label: 'Authors' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="The Great Books, home">
      <Logo size={22} class="brand__mark" />
      <span class="brand__word">The Great Books</span>
    </a>

    <button class="search-trigger ui" type="button" data-open-search aria-label="Search the library" aria-keyshortcuts="Meta+K /">
      <svg width="17" height="17" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="m11 11 3.5 3.5" stroke-linecap="round"/></svg>
      <span class="search-trigger__label">Search every book</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>

    <div class="site-header__end">
      <nav class="site-nav ui" aria-label="Primary">
        {nav.map((n) => <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
      <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="9" cy="9" r="3.4"/>
        <path d="M9 1.4v1.7M9 14.9v1.7M1.4 9h1.7M14.9 9h1.7M3.6 3.6l1.2 1.2M13.2 13.2l1.2 1.2M14.4 3.6l-1.2 1.2M4.8 13.2l-1.2 1.2" stroke-linecap="round"/>
      </svg>
      <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M15 10.6A6.6 6.6 0 0 1 7.4 3a6.6 6.6 0 1 0 7.6 7.6Z" stroke-linejoin="round"/>
      </svg>
      </button>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    /* Book covers scrolling under a thin wash turned the bar muddy, so it sits closer to solid. */
    background: color-mix(in oklch, var(--paper) 96%, transparent);
    backdrop-filter: blur(14px) saturate(1.1); -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--edge);
    /* On a phone the page runs under the status bar, so a bar pinned to top: 0 leaves a
       band above it where the page shows through and text scrolls past behind the clock.
       The inset is taken as padding rather than as a top offset, so the bar's own fill
       covers that band while its contents stay clear of the notch. */
    padding-top: env(safe-area-inset-top, 0px);
  }
  /* Three tracks, not a flex row: the outer two take the same share of whatever is left,
     which is what puts the search in the centre of the page rather than in the centre of
     the gap between the wordmark and the navigation. */
  .site-header__row {
    display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; gap: var(--s2); height: var(--header-h); min-width: 0;
  }
  .brand {
    display: inline-flex; align-items: center; min-height: 44px; gap: 0.6rem;
    justify-self: start; text-decoration: none; font-style: italic;
    font-size: var(--step-1); letter-spacing: -0.01em; color: var(--ink-strong);
    white-space: nowrap; min-width: 0;
  }
  .brand__mark { flex: 0 0 auto; }

  /* The search is the widest thing in the bar because it is the fastest way into 689 books. */
  .search-trigger {
    grid-column: 2; justify-self: center;
    display: inline-flex; align-items: center; gap: 0.6rem;
    width: min(26rem, 100%); min-height: 44px;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--edge-strong); border-radius: 999px;
    color: var(--ink-soft); background: transparent;
    transition: border-color var(--dur-fast), color var(--dur-fast), background var(--dur-fast);
  }
  .search-trigger:hover { border-color: var(--ink-mute); color: var(--ink-strong); background: var(--paper-bright); }
  .search-trigger svg { flex: 0 0 auto; }
  .search-trigger__label { flex: 1 1 auto; text-align: left; }
  .search-trigger kbd {
    font: inherit; font-size: var(--step--2); color: var(--ink-mute);
    border: 1px solid var(--edge); border-radius: 4px; padding: 0.1em 0.35em; flex: 0 0 auto;
  }

  .site-header__end {
    grid-column: 3; justify-self: end;
    display: flex; align-self: stretch; align-items: center; gap: var(--s2);
    min-width: 0;
  }
  .site-nav {
    display: flex; align-self: stretch; align-items: stretch; gap: var(--s2);
    white-space: nowrap; min-width: 0;
  }
  .site-nav a {
    display: inline-flex; align-items: center; min-height: 44px;
    text-decoration: none; color: var(--ink-soft); padding: 0 0.15rem;
    box-shadow: inset 0 -3px 0 transparent;
    transition: color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .site-nav a:hover { color: var(--ink-strong); box-shadow: inset 0 -3px 0 var(--edge); }
  .site-nav a[aria-current='page'] { color: var(--ink-strong); box-shadow: inset 0 -3px 0 var(--accent); }

  /* The toggle rides in the same track as the navigation, at its right end. */
  .theme-toggle {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 999px;
    color: var(--ink-soft);
    transition: color var(--dur-fast), background var(--dur-fast);
  }
  .theme-toggle:hover { color: var(--ink-strong); background: var(--paper-bright); }
  /* Each icon shows the scheme the button will switch to, so it reads as a destination
     rather than as a statement about where you already are. */
  .theme-toggle__sun { display: none; }
  .theme-toggle__moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle__sun { display: block; }
    :root:not([data-theme='light']) .theme-toggle__moon { display: none; }
  }
  :root[data-theme='dark'] .theme-toggle__sun { display: block; }
  :root[data-theme='dark'] .theme-toggle__moon { display: none; }
  :root[data-theme='light'] .theme-toggle__sun { display: none; }
  :root[data-theme='light'] .theme-toggle__moon { display: block; }

  @media (max-width: 1180px) {
    .site-header__row { grid-template-columns: auto 1fr auto; gap: var(--s1); height: var(--header-h); }
    .search-trigger { width: 100%; max-width: 22rem; }
    .site-nav { gap: var(--s1); font-size: var(--step--1); }
  }
  @media (max-width: 1020px) {
    /* The search keeps its centre track; the navigation sheds its least-used links first. */
    .site-nav a[href$="/about/"] { display: none; }
  }
  @media (max-width: 900px) {
    .site-nav a[href$="/authors/"] { display: none; }
    .search-trigger kbd { display: none; }
  }
  @media (max-width: 760px) {
    /* Below this there is no room either side of a centred search, so the row goes flat:
       mark, then the search, then what is left of the navigation and the toggle.

       The search keeps its shape rather than collapsing to a magnifying glass. An icon
       alone asks the reader to know what it does; a pill with a word in it is read as a
       place to type. It takes the row's spare width to do that, which is affordable here
       because the mark already links home and "Programs" is one tap further in. */
    .site-header__row { display: flex; align-items: center; height: var(--header-h); gap: var(--s0); }
    .brand__word { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .search-trigger {
      order: 2; flex: 1 1 auto; width: auto; min-width: 0; max-width: none;
      justify-content: flex-start; padding: 0.4rem 0.85rem; gap: 0.45rem;
      border-color: var(--edge);
    }
    .search-trigger__label {
      /* Truncates rather than wrapping or pushing the row wider on a narrow phone. */
      flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .site-header__end { order: 3; flex: 0 0 auto; gap: var(--s0); }
    .site-nav { gap: var(--s1); }
    /* The mark is the home link, so the word is redundant and the space is not. */
    .site-nav a[href$="/programs/"], .site-nav a[href="/"] { display: none; }
  }
</style>
<script>
  // The scheme follows the system until the reader says otherwise, and that choice is
  // theirs for good. Nothing here decides the colours: it only pins color-scheme, and
  // every token in tokens.css reads that. The same write happens inline in <head> before
  // first paint, so the page never renders in one scheme and then flips to the other.
  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');

  const describe = () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!btn) return;
    const dark = (root.dataset.theme ?? (media.matches ? 'dark' : 'light')) === 'dark';
    const to = dark ? 'light' : 'dark';
    btn.setAttribute('aria-label', `Switch to ${to} mode`);
    btn.setAttribute('title', `Switch to ${to} mode`);
  };

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark = (root.dataset.theme ?? (media.matches ? 'dark' : 'light')) === 'dark';
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('tgb-theme', next); } catch { /* private mode */ }
    describe();
  });

  // Someone who never chose a scheme keeps following their system if it changes under them.
  media.addEventListener('change', describe);
  describe();
</script>
