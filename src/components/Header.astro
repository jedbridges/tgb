---
import { url } from '~/lib/url';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/books/', label: 'Books' },
  { href: '/programs/', label: 'Programs' },
  { href: '/authors/', label: 'Authors' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="The Great Books, home">
      <Logo size={20} class="brand__mark" />
      <span class="brand__word">The Great Books</span>
    </a>
    <nav class="site-nav ui" aria-label="Primary">
      {nav.map((n) => <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <button class="search-trigger ui" type="button" data-open-search aria-label="Search the library" aria-keyshortcuts="Meta+K /">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="m11 11 3.5 3.5" stroke-linecap="round"/></svg>
      <span>Search</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    /* Book covers scrolling under a thin wash turned the bar muddy, so it sits closer to solid. */
    background: color-mix(in oklch, var(--paper) 96%, transparent);
    backdrop-filter: blur(14px) saturate(1.1); -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--paper-deeper);
  }
  .site-header__row { display: flex; align-items: center; gap: var(--s2); height: 3.75rem; min-width: 0; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; gap: 0.6rem; text-decoration: none; font-style: italic; font-size: var(--step-1); letter-spacing: -0.01em; color: var(--ink-strong); white-space: nowrap; flex: 0 0 auto; }
  .site-nav { display: flex; align-self: stretch; align-items: stretch; gap: var(--s2); margin-left: auto; white-space: nowrap; min-width: 0; }
  .site-nav a {
    display: inline-flex; align-items: center; min-height: 44px;
    text-decoration: none; color: var(--ink-soft); padding: 0 0.15rem;
    box-shadow: inset 0 -3px 0 transparent;
    transition: color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .site-nav a:hover { color: var(--ink-strong); box-shadow: inset 0 -3px 0 var(--paper-deeper); }
  .site-nav a[aria-current='page'] { color: var(--ink-strong); box-shadow: inset 0 -3px 0 var(--accent); }
  .search-trigger { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; flex: 0 0 auto; min-height: 44px; min-width: 44px; padding: 0.4rem 0.9rem; border: 1px solid var(--paper-deeper); border-radius: 999px; color: var(--ink-soft); background: transparent; transition: border-color var(--dur-fast), color var(--dur-fast); }
  .search-trigger:hover { border-color: var(--ink-mute); color: var(--ink-strong); }
  .search-trigger kbd { font: inherit; font-size: var(--step--2); color: var(--ink-mute); border: 1px solid var(--paper-deeper); border-radius: 4px; padding: 0 0.3em; }
  @media (max-width: 860px) {
    .site-header__row { gap: var(--s1); height: 3.5rem; }
    .site-nav { gap: 1.1rem; font-size: var(--step--1); }
    .search-trigger span, .search-trigger kbd { display: none; }
    .search-trigger { padding: 0; width: 44px; }
    .brand { font-size: var(--step-0); gap: 0.5rem; }
  }
  @media (max-width: 540px) {
    /* The wordmark, three nav links and search cannot all fit, and nothing here shrinks,
       so the row overflowed the viewport and the page scrolled sideways. The mark alone
       carries the home link at this width. */
    .site-nav a[href$="/about/"] { display: none; }
    .brand__word { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .site-header__row { gap: var(--s1); }
  }
</style>
