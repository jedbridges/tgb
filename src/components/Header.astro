---
import { url } from '~/lib/url';
const path = Astro.url.pathname;
const nav = [
  { href: '/books/', label: 'Books' },
  { href: '/programs/', label: 'Programs' },
  { href: '/authors/', label: 'Authors' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="The Great Books, home">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__word">The Great Books</span>
    </a>
    <nav class="site-nav ui" aria-label="Primary">
      {nav.map((n) => <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <button class="search-trigger ui" type="button" data-open-search aria-label="Search the library" aria-keyshortcuts="Meta+K /">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="m11 11 3.5 3.5" stroke-linecap="round"/></svg>
      <span>Search</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: color-mix(in oklch, var(--paper) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid color-mix(in oklch, var(--paper-deeper) 70%, transparent); }
  .site-header__row { display: flex; align-items: center; gap: var(--s2); height: 3.75rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; font-style: italic; font-size: var(--step-1); letter-spacing: -0.01em; color: var(--ink-strong); }
  .brand__mark { width: 14px; height: 22px; background: var(--accent); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%); transition: transform var(--dur) var(--ease-out); }
  .brand:hover .brand__mark { transform: translateY(2px); }
  .site-nav { display: flex; gap: var(--s2); margin-left: auto; }
  .site-nav a { text-decoration: none; color: var(--ink-soft); padding: 0.4rem 0; border-bottom: 1px solid transparent; transition: color var(--dur-fast), border-color var(--dur-fast); }
  .site-nav a:hover { color: var(--ink-strong); }
  .site-nav a[aria-current='page'] { color: var(--ink-strong); border-bottom-color: var(--accent); }
  .search-trigger { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.7rem; border: 1px solid var(--paper-deeper); border-radius: 999px; color: var(--ink-soft); transition: border-color var(--dur-fast), color var(--dur-fast); }
  .search-trigger:hover { border-color: var(--ink-mute); color: var(--ink-strong); }
  .search-trigger kbd { font: inherit; font-size: 0.7rem; color: var(--ink-mute); border: 1px solid var(--paper-deeper); border-radius: 4px; padding: 0 0.3em; }
  @media (max-width: 640px) {
    .site-nav { gap: var(--s1); }
    .search-trigger span, .search-trigger kbd { display: none; }
    .search-trigger { padding: 0.5rem; }
    .brand__word { font-size: var(--step-0); }
  }
</style>
