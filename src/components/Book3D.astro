---
/**
 * A book as a CSS 3D object. Front cover (real image or typographic), spine, page edges, shadow.
 * Renders as a <span> (inside a card link) or a <button> (detail page, openable).
 */
import { Image } from 'astro:assets';
import { coverFor, type Work } from '~/lib/catalog';
import { toneFor } from '~/lib/tone';
import '~/styles/book3d.css';
import { legibleSpine } from '~/lib/contrast';

interface Props {
  work: Work;
  authorName: string;
  width?: number;            // px
  as?: 'span' | 'button';
  pull?: boolean;            // hover pull-off-the-shelf
  tilt?: boolean;            // pointer tilt
  openable?: boolean;        // click opens cover (button only)
  eager?: boolean;           // image loading priority
  decorative?: boolean;      // inside a card: the card's own text is the accessible name
  epigraph?: { text: string; source?: string };
  class?: string;
}
const { work, authorName, width = 150, as = 'span', pull = true, tilt = false, openable = false, eager = false, decorative = false, epigraph, class: cls } = Astro.props;
const { image, meta } = coverFor(work.id);
const tone = toneFor(work.id);
const ratio = image ? image.height / image.width : 1.52;
const pages = work.data.pages ?? { short: 120, medium: 220, long: 480, epic: 900 }[work.data.length];
const depth = Math.max(12, Math.min(58, Math.round(pages / 16)));
// Spine lettering needs a spine thick enough to read and a book tall enough to hold the
// words. Decided here, because the old CSS guard matched `--d: 1` as a substring and
// silently blanked every depth from 12 to 19.
const showSpineText = depth >= 22 && width >= 96;
// The spine colour is sampled from the real cover, so it can land anywhere, including the
// mid tones where neither black nor cream lettering is readable. Measured here rather than
// guessed from a luminance threshold, which had put cream on 168 mid-tone spines.
const sampled = image && meta?.spine ? meta.spine : tone.bg;
const legible = legibleSpine(sampled);
const spine = legible.bg;
const spineInk = legible.ink;
// The generated cover is our own artwork, so its pair is checked the same way.
const cover = legibleSpine(tone.bg);
const title = work.data.title;
const titleClass = title.length > 40 ? 'xlong' : title.length > 22 ? 'long' : '';
const Tag = as;
const style = `--w:${width}px; --ratio:${ratio.toFixed(3)}; --d:${depth}px; --spine:${spine}; --spine-ink:${spineInk}; --tone-bg:${cover.bg}; --tone-ink:${cover.ink}`;
---
<Tag
  class:list={['book', { 'book--button': as === 'button' }, cls]}
  style={style}
  data-book
  data-pull={pull ? '' : undefined}
  data-tilt={tilt ? '' : undefined}
  data-openable={openable ? '' : undefined}
  data-state="shelf"
  aria-hidden={decorative ? 'true' : undefined}
  type={as === 'button' ? 'button' : undefined}
  aria-label={as === 'button' ? (openable ? `Open the cover of ${title}` : `${title} by ${authorName}`) : undefined}
  aria-expanded={openable ? 'false' : undefined}
  aria-controls={openable ? `book-inner-${work.id}` : undefined}
>
  <span class="book__scene">
    <span class="book__body">
      <span class="book__face book__front">
        <span class="side side--art">
          {image ? (
            <Image src={image} alt={decorative ? '' : `Cover of ${title}`} width={Math.round(width * 2)} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
          ) : (
            <span class="cover-gen" role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : `${title} by ${authorName}`}>
              <span class="cover-gen__series">The Great Books</span>
              <span class:list={['cover-gen__title', titleClass]}>{title}</span>
              <span class="cover-gen__author">{authorName}</span>
            </span>
          )}
        </span>
        {openable && <span class="side side--endpaper" aria-hidden="true"></span>}
      </span>
      {openable && (
        <span class="book__face book__inner" id={`book-inner-${work.id}`}>
          {epigraph ? (
            <>
              <span class="epigraph">“{epigraph.text}”</span>
              {epigraph.source && <span class="epigraph-src">{epigraph.source}</span>}
            </>
          ) : (
            <span class="titlepage">
              <span class="titlepage__title">{title}</span>
              <span class="titlepage__rule" aria-hidden="true"></span>
              <span class="titlepage__author">{authorName}</span>
              {work.data.yearDisplay && <span class="titlepage__year">{work.data.yearDisplay}</span>}
            </span>
          )}
        </span>
      )}
      {/*
        A book on a shelf rests turned a little to the left, and it never turns the other
        way: the hover pulls it to 18deg and the neighbours tip to 15 and 30, all positive.
        So the back, the page edges and the underside cannot project a single pixel, which
        was checked by painting them magenta on the live shelf and finding none. They are
        three of the six faces on every one of 689 cards, and dropping them takes 2,067
        elements out of the browse page with no visible change at all. The book on a work's
        own page does turn, and opens, so there it keeps all six.
      */}
      {openable && <span class="book__face book__back"></span>}
      <span class="book__face book__spine">{showSpineText && <span class="book__spine-text"><b>{authorName}</b>&ensp;<i>{title}</i></span>}</span>
      {openable && <span class="book__face book__pages"></span>}
      <span class="book__face book__top"></span>
      {openable && <span class="book__face book__bottom"></span>}
    </span>
    <span class="book__shadow"></span>
  </span>
</Tag>
<script>
  // One delegated controller per page for every book: pointer tilt, and open/close.
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let raf = 0;
  let pending: { el: HTMLElement; nx: number; ny: number } | null = null;

  function apply() {
    raf = 0;
    if (!pending) return;
    const { el, nx, ny } = pending;
    const open = el.dataset.state === 'open';
    const base = open ? -8 : 6;
    el.style.setProperty('--rx', `${(-ny * (open ? 4 : 9)).toFixed(2)}deg`);
    el.style.setProperty('--ry', `${(base + nx * (open ? 6 : 14)).toFixed(2)}deg`);
    el.setAttribute('data-tilting', '');
  }
  document.addEventListener('pointermove', (e) => {
    if (!fine.matches || reduce.matches) return;
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-book][data-tilt], .card [data-book]');
    if (!el) return;
    const host = el.closest<HTMLElement>('.card') ?? el;
    const r = host.getBoundingClientRect();
    pending = { el, nx: ((e.clientX - r.left) / r.width) * 2 - 1, ny: ((e.clientY - r.top) / r.height) * 2 - 1 };
    if (!raf) raf = requestAnimationFrame(apply);
  }, { passive: true });
  /* The book to the left of the hovered one.
     This is what :has(+ .card:hover) used to do in CSS, moved here because that selector
     made Safari re-resolve the sibling chain of every card on the page on every pointermove.
     One attribute goes on at most one element, and comes off again when the pointer reaches
     anything that is not a card. */
  let near: Element | null = null;
  const markNeighbour = (card: Element | null) => {
    const prev = card?.previousElementSibling ?? null;
    const next = prev && prev.classList.contains('card') ? prev : null;
    if (next === near) return;
    near?.removeAttribute('data-near');
    near = next;
    near?.setAttribute('data-near', '');
  };
  document.addEventListener('pointerover', (e) => {
    if (!fine.matches) return;
    markNeighbour((e.target as HTMLElement).closest('.card'));
  }, { passive: true });

  document.addEventListener('pointerout', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-book]');
    if (!el) return;
    const host = el.closest<HTMLElement>('.card') ?? el;
    if (host.contains(e.relatedTarget as Node)) return;
    el.style.removeProperty('--rx'); el.style.removeProperty('--ry'); el.removeAttribute('data-tilting');
  });
  function toggle(el: HTMLElement) {
    const open = el.dataset.state !== 'open';
    el.dataset.state = open ? 'open' : 'shelf';
    el.setAttribute('aria-expanded', String(open));
    el.style.removeProperty('--rx'); el.style.removeProperty('--ry');
  }
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('button[data-book][data-openable]');
    if (el) toggle(el);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('[data-book][data-state="open"]').forEach(toggle);
  });
  // Hand the clicked cover to the view transition, so the book the reader picked up is the
  // one that arrives on the next page. Cleared on pageshow so a back navigation is clean.
  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('a.card[data-slug]');
    if (!card) return;
    document.querySelectorAll<HTMLElement>('[style*="view-transition-name"]').forEach((el) => el.style.removeProperty('view-transition-name'));
    const body = card.querySelector<HTMLElement>('.book__body');
    const front = card.querySelector<HTMLElement>('.book__front');
    if (!body || !front) return;
    // Both ends of this transition are the same 3D cover at different sizes, so the pose is
    // left alone: squaring the outgoing one was written for a flat destination that, because
    // of the scoping bug above, never existed. What is cancelled is the hover tilt, so the
    // book leaves from its resting angle rather than from wherever the pointer left it.
    body.dataset.vt = 'rest';
    front.style.setProperty('view-transition-name', 'book-cover');
  }, { capture: true });
  addEventListener('pageshow', () => {
    document.querySelectorAll<HTMLElement>('.book__front').forEach((el) => el.style.removeProperty('view-transition-name'));
    document.querySelectorAll<HTMLElement>('.book__body[data-vt]').forEach((el) => delete el.dataset.vt);
  });

  // Only in-viewport books get a compositor layer hint.
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) (en.target.querySelector('.book__body') as HTMLElement).style.willChange = en.isIntersecting ? 'transform' : '';
    }, { rootMargin: '120px' });
    document.querySelectorAll('[data-book]').forEach((b) => io.observe(b));
  }
</script>
