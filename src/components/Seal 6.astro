---
/**
 * The seal.
 *
 * A struck medallion, the way an award is foil-stamped onto a book jacket. That reference
 * is doing the work: a gold seal on a cover is already the universal sign that a book has
 * been judged and chosen, which is exactly what this site claims about 689 of them. It is
 * also why the metal is gilt rather than the brand red. Gilt is not a new colour invented
 * for decoration; it is what lettering on a clothbound spine has been stamped in for two
 * hundred years, and it sits on warm paper the way it was always meant to.
 *
 * How it is made, and why not WebGL:
 *
 * The deboss is three copies of one drawing. A dark copy sits a pixel and a half high, a
 * light copy a pixel and a half low, and the real one on top is filled with the same metal
 * as the disc behind it. Only the two offset rims survive, so the type reads as pressed
 * into the surface rather than sitting on it. This is how a die-struck medal actually
 * catches light, and it costs three <use> elements.
 *
 * The moving highlight is a real light source: feSpecularLighting with an fePointLight
 * whose position follows the pointer. Not a gradient pretending to be one. The surface has
 * a normal derived from the artwork's own alpha, so the glint bends around the lettering
 * and the rings rather than sliding over them.
 *
 * The iridescence is one conic-gradient in CSS, rotated by the same pointer angle and
 * blended over the metal.
 *
 * Three.js would have cost 150KB before drawing anything, on a page whose entire script
 * budget is 183KB, to render one static object that never moves in depth. SVG filters are
 * GPU-composited, need no runtime, and degrade to a perfectly good flat gold seal when
 * anything fails.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;

const RIM = '· EVERY BOOK THAT NINE PROGRAMS ASSIGN · ONE SHELF ';
---
<div class:list={['seal', cls]} data-seal aria-hidden="true">
  <div class="seal__iris"></div>
  <svg class="seal__art" viewBox="0 0 400 400" role="presentation" focusable="false">
    <defs>
      <linearGradient id="seal-metal" x1="0" y1="0" x2="0.35" y2="1">
        <stop offset="0%" stop-color="var(--gilt-3)" />
        <stop offset="26%" stop-color="var(--gilt-1)" />
        <stop offset="48%" stop-color="var(--gilt-2)" />
        <stop offset="62%" stop-color="var(--gilt-0)" />
        <stop offset="80%" stop-color="var(--gilt-2)" />
        <stop offset="100%" stop-color="var(--gilt-3)" />
      </linearGradient>

      <!-- The disc's own edge: lit from the top, shadowed at the bottom, so it reads as a
           thing with thickness lying on the page rather than a printed circle. -->
      <linearGradient id="seal-edge" x1="0" y1="0" x2="0.3" y2="1">
        <stop offset="0%" stop-color="var(--gilt-1)" />
        <stop offset="55%" stop-color="var(--gilt-3)" />
        <stop offset="100%" stop-color="var(--gilt-4)" />
      </linearGradient>

      <!-- A real light, not a gradient impersonating one. Its position is written from the
           pointer, and the surface normal comes from the artwork's alpha, so the highlight
           travels around the lettering instead of across it. -->
      <filter id="seal-glint" x="-15%" y="-15%" width="130%" height="130%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceAlpha" stdDeviation="1.9" result="bump" />
        <feSpecularLighting
          in="bump" surfaceScale="4.2" specularConstant="0.95" specularExponent="21"
          lighting-color="#fffaf0" result="spec"
        >
          <fePointLight data-seal-light x="130" y="90" z="96" />
        </feSpecularLighting>
        <feComposite in="spec" in2="SourceAlpha" operator="in" result="specIn" />
        <feComposite in="SourceGraphic" in2="specIn" operator="arithmetic" k1="0" k2="1" k3="0.85" k4="0" />
      </filter>

      <!-- Everything struck into the metal, drawn once and used three times. -->
      <g id="seal-relief">
        <circle cx="200" cy="200" r="163" fill="none" stroke-width="2.4" />
        <circle cx="200" cy="200" r="155" fill="none" stroke-width="1" />
        <circle cx="200" cy="200" r="113" fill="none" stroke-width="1" />
        <path id="seal-rim" d="M200,200 m-136,0 a136,136 0 1,1 272,0 a136,136 0 1,1 -272,0" fill="none" />
        <text class="seal__rim">
          <textPath href="#seal-rim" startOffset="0" textLength="854" lengthAdjust="spacing">{RIM}</textPath>
        </text>
        <!-- The mark, at the centre, where a medal carries its device. -->
        <g transform="translate(144.5, 158) scale(0.0661)">
          <path d="M1681.625,391.685c-220.914-220.913-579.086-220.913-800,0v-226c220.914-220.913,579.086-220.913,800,0Z" />
          <path d="M1681.625,965.685c-220.914-220.914-579.086-220.914-800,0v-226c220.914-220.914,579.086-220.914,800,0Z" />
          <path d="M1681.625,678.685c-220.914-220.914-579.086-220.914-800,0v-226c220.914-220.914,579.086-220.914,800,0Z" />
          <path d="M800,965.685c-220.914-220.914-579.086-220.914-800,0v-800c220.914-220.913,579.086-220.913,800,0Z" />
        </g>
        <text class="seal__count" x="200" y="252">689 WORKS</text>
        <path d="M168,266 H232" stroke-width="1.4" fill="none" />
      </g>
    </defs>

    <!-- The blank. -->
    <circle cx="200" cy="200" r="178" fill="url(#seal-edge)" />
    <circle cx="200" cy="200" r="172" fill="url(#seal-metal)" />

    <g filter="url(#seal-glint)">
      <use href="#seal-relief" class="seal__cut" transform="translate(0,-2.1)" />
      <use href="#seal-relief" class="seal__lip" transform="translate(0,2.1)" />
      <use href="#seal-relief" class="seal__face" />
    </g>
  </svg>
</div>

<style>
  .seal {
    /* One gilt ramp, defined here rather than in tokens.css: it belongs to this object and
       nothing else on the site is allowed to reach for gold. */
    --gilt-0: #fff3d2;
    --gilt-1: #e4c684;
    --gilt-2: #bd9448;
    --gilt-3: #8a682f;
    --gilt-4: #57401d;
    position: relative;
    /* Fills whatever the page gives it. The wrapper owns the size and the placement,
       because a scoped class handed to a component does not reach the component's own
       root element and silently does nothing. */
    width: 100%;
    aspect-ratio: 1;
    isolation: isolate;
    filter: drop-shadow(0 14px 26px rgb(var(--shadow-ink) / calc(0.3 * var(--shadow-a))));
  }

  .seal__art { position: relative; z-index: 1; width: 100%; height: 100%; display: block; }

  /* The three strikes. The face is filled with the same metal as the blank, so only the
     dark lip above and the light lip below survive, which is the whole illusion. */
  .seal__cut { fill: var(--gilt-4); stroke: var(--gilt-4); opacity: 0.95; }
  .seal__lip { fill: var(--gilt-0); stroke: var(--gilt-0); opacity: 0.9; }
  .seal__face { fill: url(#seal-metal); stroke: url(#seal-metal); }

  .seal__rim {
    font-family: var(--font-ui);
    font-size: 19.5px;
    font-weight: 700;
    letter-spacing: 0.055em;
  }
  .seal__count {
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-anchor: middle;
  }

  /* Iridescence. One conic sweep over the metal, turned by the pointer. Scoped to this
     element by isolation above, so the blend never reaches the page behind it. */
  .seal__iris {
    position: absolute;
    inset: 5.6%;   /* matches the disc, or the sweep haloes outside the metal */
    border-radius: 50%;
    z-index: 2;
    pointer-events: none;
    mix-blend-mode: overlay;
    opacity: 0.55;
    background: conic-gradient(
      from calc(var(--sweep, 0) * 1deg),
      #ffd9a8 0deg, #b6f0e2 52deg, #cdb9ff 108deg, #ffc9dd 164deg,
      #fff0c2 214deg, #a8e8ff 268deg, #ffd0b0 322deg, #ffd9a8 360deg
    );
    transition: opacity var(--dur) var(--ease-out);
  }

  /* The press. It arrives the way it was made: from slightly above and larger, turning
     into its skew as it lands, with the light still travelling after it settles. */
  @media (prefers-reduced-motion: no-preference) {
    .seal { animation: seal-strike 900ms cubic-bezier(0.16, 1, 0.3, 1) 220ms backwards; }
    @keyframes seal-strike {
      from { opacity: 0; transform: translateY(-26px) rotate(6deg) scale(1.14); }
      60% { opacity: 1; }
      to { opacity: 1; transform: none; }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .seal { transition: transform var(--dur) var(--ease-out); }
    .seal:hover .seal__iris { opacity: 0.78; }
  }
</style>

<script>
  /*
   * The light, and only the light.
   *
   * Everything visual is CSS and SVG; this moves one fePointLight and one gradient angle.
   * It is bounded to a single rAF per frame and it never runs on a device without a real
   * pointer, so a phone renders the seal as a still struck medal, which is what a struck
   * medal is.
   */
  const seal = document.querySelector<HTMLElement>('[data-seal]');
  const light = seal?.querySelector<SVGElement>('[data-seal-light]');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  if (seal && light && fine.matches && !still.matches) {
    let frame = 0;
    let tx = 0, ty = 0;

    const rest = () => {
      light.setAttribute('x', '130'); light.setAttribute('y', '90');
      seal.style.removeProperty('--sweep');
      seal.style.removeProperty('transform');
    };

    addEventListener('pointermove', (e) => {
      // The seal reacts across the whole hero, not only when the pointer is on it: a
      // medal catches the light in the room, not the light you touch it with.
      const hero = seal.closest('section');
      if (!hero) return;
      const h = hero.getBoundingClientRect();
      if (e.clientY < h.top || e.clientY > h.bottom) { rest(); return; }

      const r = seal.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      // Light position in the SVG's own 400-unit space, pushed a little past the rim so
      // the glint can leave the disc entirely rather than sticking to its edge.
      tx = ((e.clientX - r.left) / r.width) * 400;
      ty = ((e.clientY - r.top) / r.height) * 400;
      const angle = (Math.atan2(e.clientY - cy, e.clientX - cx) * 180) / Math.PI;

      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        light.setAttribute('x', String(Math.round(tx)));
        light.setAttribute('y', String(Math.round(ty)));
        seal.style.setProperty('--sweep', String(Math.round(angle)));
        // A hint of tilt toward the pointer, in the same language as the books.
        const dx = Math.max(-1, Math.min(1, (e.clientX - cx) / (r.width * 1.6)));
        const dy = Math.max(-1, Math.min(1, (e.clientY - cy) / (r.height * 1.6)));
        seal.style.transform = `perspective(900px) rotateY(${dx * 7}deg) rotateX(${-dy * 7}deg)`;
      });
    }, { passive: true });

    addEventListener('blur', rest);
    document.addEventListener('mouseleave', rest);
  }
</script>
