---
/*
 * Which translation to read, as part of the guide rather than beside it.
 *
 * "Best translation of the Iliad" is the question a reader asks immediately before buying,
 * and the answer already lives in every work's frontmatter. It used to show only in the
 * hero and as an unlinked list in the sidebar, with no heading, so the page never read as
 * an answer to that question. This section is the answer: every edition we stand behind,
 * why, and a link to each.
 */
import { amazonUrl, bookshopUrl } from '~/lib/affiliates';
import { describeEdition, editionKey, isTranslated } from '~/lib/editions';
import type { Work } from '~/lib/catalog';
import { url } from '~/lib/url';
interface Props { work: Work; authorName: string }
const { work, authorName } = Astro.props;
const d = work.data;
const noun = isTranslated(work) ? 'translation' : 'edition';
const picks = [
  ...(d.recommendedEdition ? [{ ed: d.recommendedEdition, label: 'Our pick' }] : []),
  ...d.otherEditions.map((ed) => ({ ed, label: 'Also good' })),
].map((p) => ({ ...p, info: describeEdition(work, authorName, p.ed), key: editionKey(p.ed) }))
  .filter((p) => p.info.named);
---
{picks.length > 0 && (
  <section class="picks" id="translation" aria-labelledby="translation-h" data-pagefind-ignore>
    <h2 class="picks__h" id="translation-h">Which {noun} to read</h2>
    {picks.length > 1 && (
      <p class="picks__lede">
        For <em>{d.title}</em> the {noun} is most of the decision. Our pick is the {picks[0].info.editionName ?? picks[0].info.short}; {picks.length === 2 ? 'the other is' : 'the others are'} good for different reasons.
      </p>
    )}
    <ol class="picks__list">
      {picks.map(({ ed, label, info, key }, i) => (
        <li class:list={['pick', { 'pick--top': i === 0 && label === 'Our pick' }]}>
          <p class="pick__label">{label}</p>
          <p class="pick__name">
            {ed.title ?? d.title}{info.translator && <>, translated by {info.translator}</>}{!info.translator && info.editor && <>, edited by {info.editor}</>}
          </p>
          {(ed.publisher || ed.year) && <p class="pick__pub">{[ed.publisher, ed.year].filter(Boolean).join(', ')}</p>}
          {ed.why && <p class="pick__why">{ed.why}</p>}
          <p class="pick__buy">
            <a class="btn" href={amazonUrl(info.target)} target="_blank" rel="sponsored noopener" data-affiliate="amazon" data-work={work.id} data-placement="picks" data-edition={key}>
              Amazon<span class="visually-hidden">: the {info.editionName ?? info.short}, opens in a new tab</span>
            </a>
            <a class="btn" href={bookshopUrl(info.target)} target="_blank" rel="sponsored noopener" data-affiliate="bookshop" data-work={work.id} data-placement="picks" data-edition={key}>
              Bookshop.org<span class="visually-hidden">: the {info.editionName ?? info.short}, opens in a new tab</span>
            </a>
          </p>
        </li>
      ))}
    </ol>
    {noun === 'translation' && <p class="picks__hub ui"><a href={url('/translations/')}>Our pick of translation for every book on the lists →</a></p>}
  </section>
)}
<style>
  .picks { display: grid; gap: var(--s2); padding-top: var(--s2); border-top: var(--rule-section); scroll-margin-top: var(--stick, 5rem); }
  .picks__h { font-style: italic; font-size: var(--step-2); }
  .picks__lede { color: var(--ink-soft); line-height: var(--lh-prose); max-width: var(--measure); text-wrap: pretty; }
  .picks__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: var(--s2) var(--s3); }
  .pick { display: grid; gap: var(--s-1); align-content: start; padding-top: var(--s1); border-top: 1px solid var(--edge); min-width: 0; }
  .pick--top { border-top-color: var(--accent); }
  .pick__label { font-family: var(--font-ui); font-size: var(--step--2); font-weight: var(--w-emph); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--ink-mute); }
  .pick--top .pick__label { color: var(--accent); }
  .pick__name { font-size: var(--step-0); color: var(--ink-strong); line-height: 1.3; }
  .pick__pub { font-family: var(--font-ui); font-size: var(--step--2); color: var(--ink-mute); }
  .pick__why { color: var(--ink-soft); font-size: var(--step--1); line-height: var(--lh-ui); text-wrap: pretty; }
  .pick__buy { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-1); }
  .picks__hub { font-size: var(--step--1); }
  .picks__hub a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--edge); }
  .picks__hub a:hover { color: var(--accent); border-color: currentColor; }
  .pick__buy .btn { font-size: var(--step--2); padding: 0.55em 1em; }
</style>
