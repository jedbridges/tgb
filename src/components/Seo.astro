---
import { abs } from '~/lib/url';
interface Props {
  title: string;
  description: string;
  image?: string;          // absolute or site-relative
  type?: 'website' | 'article' | 'book';
  noindex?: boolean;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, image, type = 'website', noindex = false, jsonld } = Astro.props;
const siteName = 'The Great Books';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = abs(Astro.url.pathname);
const ogImage = image ? (image.startsWith('http') ? image : abs(image).replace(/\/$/, '')) : abs('/og-default.png').replace(/\/$/, '');
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,follow" />}
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type === 'book' ? 'book' : type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
