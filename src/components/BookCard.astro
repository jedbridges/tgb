---
import Book3D from './Book3D.astro';
import { workUrl } from '~/lib/url';
import { coverFor, tintVars, yearShort, type Work } from '~/lib/catalog';
interface Props { work: Work; authorName: string; width?: number; eager?: boolean; hasGuide?: boolean; showMeta?: boolean; index?: number }
const { work, authorName, width = 140, eager = false, hasGuide = false, showMeta = true, index } = Astro.props;
// The colour this book throws when it is pulled off the shelf. Empty for a cover that has
// none, and the glow below then renders as nothing.
const _m = coverFor(work.id).meta;
const tint = tintVars(_m);
---
<a
  class:list={['card', !showMeta && 'card--bare']}
  href={workUrl(work.id)}
  data-slug={work.id}
  style={[index !== undefined ? `--i:${index};` : '', tint].filter(Boolean).join('') || undefined}
>
  <span class="card__stage" style={`--stage-h:${Math.round(width * 1.6)}px`}>
    <Book3D work={work} authorName={authorName} width={width} eager={eager} decorative />
  </span>
  <span class="card__ledge" aria-hidden="true">{tint && <span class="card__glow"></span>}</span>
  {showMeta && (
    <>
      <span class="card__title">{work.data.title}</span>
      <span class="card__author">{authorName} · {yearShort(work)}</span>
      <span class="card__tail">{hasGuide && <span class="card__guide">Guide</span>}</span>
    </>
  )}
</a>
<style>
  /* Every card on a shelf row takes its row heights from the grid, not from its own text.
     A three-line title in one card therefore sets the title band for the whole row, so the
     authors line up with each other, the list counts line up with each other, and the
     shelves run straight. Before this the card sized itself and each column landed
     wherever its text ended. The five bands are: book, shelf, title, author, tail. */
  .card {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    text-decoration: none; color: inherit; position: relative; min-width: 0;
    --ledge: 12px;
    /* Room above the book for the hover lift, reserved only where there is a pointer that
       can hover. A touch device never needs it and should not pay for it in whitespace. */
    --lift: 0px;
  }
  @media (hover: hover) and (pointer: fine) { .card { --lift: 52px; } }
  .card--bare { grid-row: span 2; }
  .card--bare .card__ledge { margin-bottom: max(var(--s1), calc(var(--s4) - var(--lift))); }
  /* The browse filters hide cards with the hidden attribute, and an author display rule
     outranks the user agent's [hidden] rule whatever its specificity. */
  .card[hidden] { display: none; }

  .card__stage {
    /* content-visibility below brings paint containment with it, which clips to this
       element's padding box, so a book rising off the shelf on hover had its top sheared
       off. The padding is inside the clip, so reserving it here gives the book somewhere
       to go; the height grows by the same amount and box-sizing keeps the content box,
       and therefore the book's resting position on the shelf, identical. */
    display: flex; align-items: flex-end; justify-content: center;
    height: calc(var(--stage-h) + var(--lift));
    padding: var(--lift) 8% 0; position: relative; z-index: 1;
    /* 689 books ship on one page and the cover is the whole cost of one: three stacked 3D
       faces, a shadow and an image. Containment sits here rather than on the card so the
       text below stays laid out, which is what lets the row heights resolve. */
    content-visibility: auto;
    contain-intrinsic-size: auto calc(var(--stage-h) + var(--lift));
  }

  /* The light a book throws when it comes off the shelf.
     Not a halo around the card, which is a video-game hover and would be noise across six
     hundred of them: a jacket pulled into the light bounces its own colour down onto the
     wood it is standing on. So this pools at the ledge and fades upward, it sits behind the
     book rather than around it, and it exists only while the book is actually out. */
  .card__glow {
    /* Inside the ledge, not a child of the card. As a grid item it took rows out of the
       card's five-row subgrid and pushed the shelf, the title and the author down a band
       each, which broke every row on the page. */
    position: absolute; left: 50%; bottom: 100%; translate: -50% 0;
    width: 170%; height: 9rem; pointer-events: none;
    opacity: 0; --glow-a: 0.55;
    /* Anchored to the top of the wood, not to the wood itself. Pooled on the shelf the
       light landed on the darkest surface in the row and read as nothing; it belongs on
       the wall the book is standing against. */
    background: radial-gradient(
      ellipse 56% 100% at 50% 100%,
      oklch(var(--tint-l) var(--tint-c) var(--tint-h) / var(--glow-a)),
      oklch(var(--tint-l) var(--tint-c) var(--tint-h) / calc(var(--glow-a) * 0.34)) 44%,
      transparent 74%);
    transition: opacity var(--dur) var(--ease-out);
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .card__glow { --glow-a: 0.78; } }
  :root[data-theme='dark'] .card__glow { --glow-a: 0.78; }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__glow, .card:focus-visible .card__glow { opacity: 1; }
    /* The glow is wider than the card it belongs to, and the neighbouring cards paint their
       own shelf and stage over it, which sheared it off with a hard vertical edge on each
       side. Lifting the hovered card above its siblings lets its light finish. */
    .card:hover, .card:focus-visible { z-index: 3; }
  }
  @media (prefers-reduced-motion: reduce) { .card__glow { transition: none; } }

  .card__ledge {
    position: relative;
    height: var(--ledge); background: var(--shelf-wood);
    background-image: linear-gradient(to bottom, var(--shelf-edge), var(--shelf-wood) 35%, color-mix(in oklch, var(--shelf-wood) 75%, black));
    box-shadow: 0 6px 12px -4px rgb(var(--shadow-ink) / calc(0.35 * var(--shadow-a))), inset 0 1px 0 color-mix(in oklch, var(--shelf-edge) 60%, var(--ink-strong));
    margin: -1px 0 0;
  }
  /* A shelf runs the width of the wall, not the width of the books standing on it. Each
     ledge continues to the right and the grid clips it, so a row holding four books still
     gets a full shelf. Cards later in the row simply paint their own ledge over it. */
  .card__ledge::after {
    content: ''; position: absolute; inset: 0 -100vw 0 100%;
    background: inherit; box-shadow: inherit;
  }

  .card__title {
    padding: var(--s1) 0 0;
    font-size: var(--step-0); line-height: var(--lh-heading); color: var(--ink-strong);
    text-wrap: balance; transition: color var(--dur-fast);
  }
  .card__author {
    padding: var(--s-1) 0 0;
    color: var(--ink-soft); font-family: var(--font-ui); font-size: var(--step--2);
    line-height: var(--lh-ui); letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
    text-wrap: pretty;
  }
  .card__tail {
    /* The space the stage borrowed above the books is given back here, so reserving the
       headroom does not push the shelves apart. */
    padding: var(--s0) 0 max(var(--s1), calc(var(--s4) - var(--lift)));
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.5rem;
    align-content: start;
  }
  /* The one thing a reader most wants to know before clicking: is there anything written here? */
  .card__guide {
    display: inline-flex; align-items: center; gap: 0.3em;
    font-family: var(--font-ui); font-size: var(--step--2); line-height: 1;
    color: var(--accent); padding: 0.25em 0.5em;
    border: 1px solid color-mix(in oklch, var(--accent) 50%, transparent);
    border-radius: 2px;
  }
  .card__guide::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  .card:hover .card__title { color: var(--accent); }
</style>
