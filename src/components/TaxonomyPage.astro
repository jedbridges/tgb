---
import BookCard from './BookCard.astro';
import { placeholderAuthor, loadCatalog, sortedByAssignment, hasGuide, type Work } from '~/lib/catalog';
import { url } from '~/lib/url';
interface Props { kind: 'themes' | 'genres' | 'eras'; entry: { id: string; data: { label: string; description?: string } }; kindLabel: string; match: (w: Work) => boolean }
const { kind, entry, kindLabel, match } = Astro.props;
const { works, authors } = await loadCatalog();
const list = await sortedByAssignment(works.filter(match));
const param = { themes: 'theme', genres: 'genre', eras: 'era' }[kind];
/* Search groups these under their own headers. The label words differ from the page kind
   on purpose: a search for "tragedy" should say Form, not Genre, because that is the word
   the book pages use. */
const searchType = { themes: 'Theme', genres: 'Form', eras: 'Era' }[kind];
---
<section class="wrap head page-open" data-pagefind-body data-pagefind-filter={`type:${searchType}`}>
  <span class="visually-hidden" data-pagefind-meta={`type:${searchType}`}></span>
  <span class="visually-hidden" data-pagefind-meta={`slug:${entry.id}`}></span>
  <span class="visually-hidden" data-pagefind-meta={`count:${list.length}`}></span>
  <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
    <ol><li><a href={url('/')}>The Great Books</a></li><li><a href={url('/books/')}>All books</a></li><li>{kindLabel}</li></ol>
  </nav>
  <h1 class="italic" data-pagefind-meta="title" data-pagefind-weight="10">{entry.data.label}</h1>
  {entry.data.description && <p class="lede">{entry.data.description}</p>}
  <p class="ui count" data-pagefind-ignore>{list.length} {list.length === 1 ? 'work' : 'works'} · <a href={url('/books/') + `?${param}=${entry.id}`}>Refine in the browser →</a></p>
</section>
<section class="wrap" data-pagefind-ignore>
  {list.length ? (
    <div class="shelf-grid">
      {list.map((w, i) => <BookCard work={w} authorName={(authors.get(w.data.author.id) ?? placeholderAuthor(w.data.author.id)).data.name} width={140} index={Math.min(i, 12)} eager={i < 6} />)}
    </div>
  ) : (
    <p class="empty">Nothing on this shelf yet.</p>
  )}
</section>
<style>
  .head { padding-block: var(--s4) var(--s3); }
  .head h1 { font-size: var(--step-4); }
  .lede { margin-top: var(--s1); font-size: var(--step-1); color: var(--ink-soft); max-width: 50ch; }
  .count { margin-top: var(--s1); color: var(--ink-mute); }
  .count a { color: var(--accent); text-decoration: none; }
  .empty { color: var(--ink-soft); font-style: italic; }
</style>
