---
/* Long lists (a theme's 148 books, its passages by work) show their first stretch and a
   button for the rest. Everything stays in the HTML: crawlers and readers without script
   get the full list, and the clip is added only once the script runs. Mark a container
   with data-clip="36" and a data-clip-label noun ("books", "works"). */
---
<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-clip]')) {
    const keep = Number(box.dataset.clip);
    const items = [...box.children] as HTMLElement[];
    if (!keep || items.length <= keep + 6) continue; // not worth a button for a handful
    const rest = items.slice(keep);
    rest.forEach((el) => { el.hidden = true; });
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'clip__more ui';
    btn.textContent = `Show all ${items.length} ${box.dataset.clipLabel ?? ''}`.trim();
    btn.addEventListener('click', () => {
      rest.forEach((el) => { el.hidden = false; });
      btn.remove();
      rest[0].querySelector<HTMLElement>('a, [tabindex]')?.focus({ preventScroll: true });
    });
    box.after(btn);
  }
</script>
<style is:global>
  /* A card that sets its own display would otherwise ignore the hidden attribute. */
  [data-clip] > [hidden] { display: none !important; }
  .clip__more {
    display: block; margin: var(--s3) auto 0; min-height: 44px; padding: 0.5em 1.4em;
    font-family: var(--font-ui); font-size: var(--step--1); color: var(--ink-strong);
    border: 1px solid var(--edge-strong); border-radius: 999px; background: none; cursor: pointer;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .clip__more:hover, .clip__more:focus-visible { border-color: var(--accent); color: var(--accent); }
</style>
