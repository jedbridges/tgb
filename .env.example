# Public site origin, no trailing slash. Used for canonicals, sitemap, OG.
SITE_URL=http://localhost:4321
# Amazon Associates tracking id (e.g. thegreatbooks-20). Leave blank until approved.
AMAZON_ASSOCIATE_TAG=
# Bookshop.org affiliate id (numeric). Leave blank until approved.
BOOKSHOP_AFFILIATE_ID=
# GA4 measurement id (G-XXXXXXX). Leave blank to disable analytics.
PUBLIC_GA4_ID=
# Google Books API key. Build-time only, used by scripts/find-editions.ts to fill in the
# recommended-edition ISBN for works that still lack one. Never sent to the browser.
GOOGLE_BOOKS_API_KEY=
